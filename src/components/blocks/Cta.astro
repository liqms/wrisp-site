---
import type { Copy } from '@/lib/copy';
import { leafKey } from '@/lib/copy';
import { localePath } from '@/lib/locales';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const cta = copy.cta;
const here = leafKey(Astro.currentLocale);
---

<section class="cta" id="next">
  <div class="wrap">
    <div class="cta-box">
      <h2>{cta.title}</h2>
      <p class="lead">{cta.sub}</p>
      <p class="cta-priv"><a href={localePath(here, 'privacy/')}>{cta.privacy}</a></p>
      <svg class="cta-ghost" viewBox="0 0 360 200" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
        <rect x="2" y="2" width="356" height="196" rx="16" fill="none" stroke="var(--hair-2)" stroke-width="1.5"/>
        <rect x="18" y="18" width="36" height="140" rx="6" fill="none" stroke="var(--hair-1)"/>
        <line x1="70" y1="34" x2="330" y2="34" stroke="var(--hair-2)"/>
        <rect x="70" y="52" width="120" height="16" rx="4" fill="var(--hair-1)"/>
        <rect x="70" y="78" width="220" height="8" rx="4" fill="var(--hair-1)"/>
        <rect x="70" y="94" width="190" height="8" rx="4" fill="var(--hair-1)"/>
        <rect x="70" y="118" width="70" height="16" rx="4" fill="var(--hair-2)"/>
      </svg>
    </div>
  </div>
</section>

<style>
  /* 原型用内联 margin-top:44px 把 CTA 块压在 FAQ 之后，拆成独立区块后改由本区块上缘留白承担 */
  .cta {
    padding-block: 44px 96px;
  }
  /*
   * 面板按判面规则落卡片档 --surface-2，辉光与发丝线承担反白关系
   * （.cta-box::before 的 --glow-strong 仍是该令牌唯一消费者，spec §4.5）。
   */
  .cta-box {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--hair-2);
    border-radius: 18px;
    background: var(--surface-2);
    color: var(--text-1);
    padding: 64px 56px;
    text-align: center;
  }
  .cta-box::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(640px 260px at 50% -20%, var(--glow-strong), transparent 70%);
  }
  .cta-ghost {
    position: absolute;
    left: 50%;
    bottom: -44px;
    transform: translateX(-50%);
    width: min(360px, 62%);
    pointer-events: none;
    z-index: 0;
  }
  .cta-box h2 {
    position: relative;
    font-size: clamp(26px, 3.8vw, 42px);
    color: var(--text-1);
    max-width: 760px;
    margin: 0 auto;
  }
  .cta-box .lead {
    position: relative;
    color: var(--text-2);
    margin: 14px auto 0;
  }
  /* relative 浮到 ::before 辉光之上；z-index:1 压过 z-index:0 的 ghost */
  .cta-box .cta-priv {
    position: relative;
    z-index: 1;
    margin: 26px auto 0;
    font-size: 13.5px;
    color: var(--text-2);
  }
  .cta-box .cta-priv a {
    color: var(--accent-300);
  }
  @media (max-width: 760px) {
    .cta-box {
      padding: 44px 22px;
    }
  }
</style>
