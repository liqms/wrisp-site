---
import type { Copy } from '@/lib/copy';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const faq = copy.faq;
const spec = copy.spec;
---

<section class="reveal faq-sec" id="waitlist">
  <div class="wrap">
    <div class="eyebrow">{faq.eyebrow}</div>
    <h2 class="h-2">{faq.title}</h2>
    <div class="faq">
      <details open>
        <summary><span class="qmk">Q1</span><span>{faq['1q']}</span><span class="chev">›</span></summary>
        <div class="ans">{faq['1a']}</div>
      </details>
      <details>
        <summary><span class="qmk">Q2</span><span>{faq['2q']}</span><span class="chev">›</span></summary>
        <div class="ans">{faq['2a']}</div>
      </details>
      <details>
        <summary><span class="qmk">Q3</span><span>{faq['3q']}</span><span class="chev">›</span></summary>
        <div class="ans">{faq['3a']}</div>
      </details>
      <details>
        <summary><span class="qmk">Q4</span><span>{faq['4q']}</span><span class="chev">›</span></summary>
        <div class="ans">{faq['4a']}</div>
      </details>
      <details>
        <summary><span class="qmk">Q5</span><span>{faq['5q']}</span><span class="chev">›</span></summary>
        <div class="ans">{faq['5a']}</div>
      </details>
    </div>
    <div class="spec">
      <span class="chip"><span>{spec.p}</span><span class="mono">{spec.pv}</span></span>
      <span class="chip"><span>{spec.m}</span><span class="mono">{spec.mv}</span></span>
      <span class="chip"><span>{spec.g}</span><span class="mono">{spec.gv}</span></span>
      <span class="chip"><span>{spec.u}</span><span class="mono">{spec.uv}</span></span>
    </div>
  </div>
</section>

<style>
  /* 原型里 FAQ 与 CTA 同属一个 section；拆开后间距上移到本块底部留白为 0，由 CTA 补下缘 */
  .faq-sec {
    padding-block: 96px 0;
  }
  .faq {
    margin-top: 36px;
    border-top: 1px solid var(--line);
  }
  .faq details {
    border-bottom: 1px solid var(--line);
  }
  .faq summary {
    list-style: none;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 18px 0;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
  }
  .faq summary > span:not(.qmk):not(.chev) {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary .qmk {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--accent);
    padding-top: 4px;
    flex: none;
  }
  .faq summary .chev {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
    transition: transform 0.18s ease;
    flex: none;
  }
  .faq details[open] summary .chev {
    transform: rotate(90deg);
  }
  .faq .ans {
    padding: 0 0 20px 24px;
    font-size: 14.5px;
    color: var(--muted);
    max-width: 760px;
  }
  .spec {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 34px;
  }
  .spec .chip {
    border: 1px solid var(--line);
    background: #fff;
    border-radius: 999px;
    padding: 8px 14px;
    font-size: 13px;
    color: var(--ink-2);
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }
  .spec .chip .mono {
    font-size: 11.5px;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .spec {
      gap: 8px;
    }
    .spec .chip {
      white-space: normal;
      flex-wrap: wrap;
      font-size: 12.5px;
      padding: 7px 12px;
    }
  }
</style>
