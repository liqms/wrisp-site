---
import type { Copy } from '@/lib/copy';
import { leafKey } from '@/lib/copy';
import { localePath } from '@/lib/locales';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const faq = copy.faq;
const privacy = localePath(leafKey(Astro.currentLocale || ''), 'privacy/');
// 按编号键渲染：加一条问答只改文案文件，不必再动这个组件
const questions = Object.keys(faq)
  .filter((k) => /^\d+q$/.test(k))
  .map((k) => Number(k.slice(0, -1)))
  .sort((a, b) => a - b);
---

<section class="reveal faq-sec" id="faq">
  <div class="wrap">
    <h2 class="h-2">{faq.title}</h2>
    <div class="faq">
      {questions.map((n) => (
        <details open={n === 1}>
          <summary><span class="qmk">Q{n}</span><span>{faq[`${n}q`]}</span><span class="chev">›</span></summary>
          <div class="ans">
            {faq[`${n}a`]}
            {n === 1 && faq['1link'] && <a class="qlink" href={privacy}>{faq['1link']}</a>}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  /* 2026-11-07：区标题居中，问答列表仍左对齐——与 03/04/05 区同一刀法。 */
  .h-2 {
    text-align: center;
  }
  /* 原型里 FAQ 与 CTA 同属一个 section；拆开后间距上移到本块底部留白为 0，由 CTA 补下缘 */
  .faq-sec {
    padding-block: 96px 0;
  }
  .faq {
    margin-top: 36px;
    border-top: 1px solid var(--hair-1);
  }
  .faq details {
    border-bottom: 1px solid var(--hair-1);
  }
  .faq summary {
    list-style: none;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 18px 0;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
  }
  .faq summary > span:not(.qmk):not(.chev) {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary .qmk {
    font-family: var(--mono);
    font-size: 12px;
    /* 「Q」是承载字符的强调标记，非正文强调走 --accent-400（--accent-300 归链接与焦点环） */
    color: var(--accent-400);
    padding-top: 4px;
    flex: none;
  }
  .faq summary .chev {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-3);
    transition: transform 0.18s ease;
    flex: none;
  }
  .faq details[open] summary .chev {
    transform: rotate(90deg);
  }
  .faq .ans {
    padding: 0 0 20px 24px;
    font-size: 14.5px;
    color: var(--text-2);
    max-width: 760px;
  }
  .faq .qlink {
    display: inline-block;
    margin-left: 8px;
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--accent-300);
    white-space: nowrap;
  }
</style>
