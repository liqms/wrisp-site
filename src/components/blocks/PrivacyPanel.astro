---
import type { Copy } from '@/lib/copy';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const priv = copy.priv;
---

<section class="privacy" id="privacy">
  <div class="wrap">
    <div class="eyebrow">{priv.eyebrow}</div>
    <h2 class="h-2">{priv.title}</h2>
    <p class="lead">{priv.sub}</p>
    <div class="pill-table">
      <div class="pt-row head">
        <div class="c">{priv.hPath}</div>
        <div class="c">{priv.hSend}</div>
        <div class="c">{priv.hDefault}</div>
      </div>
      <div class="pt-row">
        <div class="c k">Local AI</div>
        <div class="c">{priv['1b']}</div>
        <div class="c st">{priv['1s']}</div>
      </div>
      <div class="pt-row">
        <div class="c k">BYOK <span>{priv['2k']}</span></div>
        <div class="c">{priv['2b']}</div>
        <div class="c st">{priv['2s']}</div>
      </div>
      <div class="pt-row">
        <div class="c k">IP <span>{priv['3k']}</span></div>
        <div class="c">{priv['3b']}</div>
        <div class="c st">{priv['3s']}</div>
      </div>
      <div class="pt-row">
        <div class="c k">Update</div>
        <div class="c">{priv['4b']}</div>
        <div class="c st">{priv['4s']}</div>
      </div>
      <div class="pt-row">
        <div class="c k">Waitlist</div>
        <div class="c">{priv['5b']}</div>
        <div class="c st">{priv['5s']}</div>
      </div>
    </div>
    <ul>
      <li>{priv.m1}</li>
      <li>{priv.m2}</li>
      <li>{priv.m3}</li>
    </ul>
  </div>
</section>

<style>
  /* 与 .band 不同：只有上边线、上下留白 72px，所以不复用那个类 */
  .privacy {
    background: var(--paper-2);
    border-top: 1px solid var(--line);
    padding-block: 72px;
  }
  .pill-table {
    margin-top: 30px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: #fff;
  }
  .pt-row {
    display: grid;
    grid-template-columns: 200px 1fr 190px;
    border-bottom: 1px solid var(--line);
  }
  .pt-row:last-child {
    border-bottom: 0;
  }
  .pt-row.head {
    background: var(--paper);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pt-row .c {
    padding: 14px 18px;
    font-size: 13.5px;
    color: var(--ink-2);
    border-right: 1px solid var(--line);
  }
  .pt-row .c:last-child {
    border-right: 0;
  }
  .pt-row .c.k {
    font-weight: 600;
    color: var(--ink);
  }
  .pt-row .c.st {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--muted);
  }
  .privacy ul {
    margin: 24px 0 0 18px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .privacy ul li {
    margin-bottom: 8px;
  }
  @media (max-width: 880px) {
    .pt-row {
      grid-template-columns: 1fr;
    }
    .pt-row .c {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .pt-row.head {
      display: none;
    }
  }
</style>
