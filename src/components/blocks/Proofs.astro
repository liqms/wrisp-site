---
import type { Copy } from '@/lib/copy';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const proof = copy.proof;
// 这两张卡的 mock 文字参与动画，按裁决②住在 flow.json；卡标题（1t/1b…5t/5b）与
// 另外两张不动的卡（m2* / m3*）留在 proof.json。
const flow = copy.flow;
---

<section class="reveal" id="proofs">
  <div class="wrap">
    <div class="eyebrow">{proof.eyebrow}</div>
    <h2 class="h-2">{proof.title}</h2>
    <div class="proof-grid">
      <div class="proof-card">
        <div class="mock" data-shot="info-cards">
          <div class="mock-chrome" aria-hidden="true"><i></i><i></i><i></i></div>
          <div class="mrow"><span class="mk-badge">{flow.file.m1t}</span><span>{flow.file.m1a}</span></div>
          <div class="mrow"><span class="mk-badge">{flow.file.m1b}</span><span>{flow.file.m1c}</span></div>
          <div class="mrow"><span class="mk-badge">{flow.file.m1d}</span><span>{flow.file.m1e}</span></div>
        </div>
        <div class="proof-body">
          <div class="pname">INFO CARDS</div>
          <h3>{proof['1t']}</h3>
          <p>{proof['1b']}</p>
        </div>
      </div>
      <div class="proof-card">
        <div class="mock" data-shot="todo">
          <div class="mock-chrome" aria-hidden="true"><i></i><i></i><i></i></div>
          <div class="mrow"><span class="box on">✓</span><span>{proof.m2a}</span></div>
          <div class="mrow"><span class="box"></span><span>{proof.m2b}</span></div>
          <div class="mrow"><span class="box"></span><span>{proof.m2c}</span></div>
        </div>
        <div class="proof-body">
          <div class="pname">TO-DO LIST</div>
          <h3>{proof['2t']}</h3>
          <p>{proof['2b']}</p>
        </div>
      </div>
      <div class="proof-card">
        <div class="mock" data-shot="report">
          <div class="mock-chrome" aria-hidden="true"><i></i><i></i><i></i></div>
          <div class="mrow"><span class="mk-badge">{proof.m3a}</span></div>
          <div class="doc-l"><b>{proof.m3s1}</b><span>{proof.m3p1}</span></div>
          <div class="doc-l"><b>{proof.m3s2}</b><span>{proof.m3p2}</span></div>
          <div class="doc-l"><b>{proof.m3s3}</b><span>{proof.m3p3}</span></div>
        </div>
        <div class="proof-body">
          <div class="pname">WEEKLY REPORT</div>
          <h3>{proof['3t']}</h3>
          <p>{proof['3b']}</p>
        </div>
      </div>
      <div class="proof-card">
        <div class="mock" data-shot="creation">
          <div class="mock-chrome" aria-hidden="true"><i></i><i></i><i></i></div>
          <div class="doc-h">{flow.recall.m5h}</div>
          <div class="doc-p">{flow.recall.m5p}</div>
          <div class="mrow"><span class="mk-badge">{flow.recall.m5a}</span><span>{flow.recall.m5b}</span></div>
        </div>
        <div class="proof-body">
          <div class="pname">CREATION SPACE</div>
          <h3>{proof['5t']}</h3>
          <p>{proof['5b']}</p>
        </div>
      </div>
    </div>
  </div>
  <div class="closer">
    <div class="wrap">
      <p>{proof.band}</p>
    </div>
  </div>
</section>

<style>
  /* 此处 mock 为 CSS 示意，正式版换成真实产品截图。 */
  .proof-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-top: 44px;
  }
  .proof-card {
    border: 1px solid var(--hair-1);
    border-radius: var(--r-card);
    background: var(--surface-2);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.18s, transform 0.18s;
  }
  .proof-card:hover {
    border-color: var(--accent-fill);
    transform: translateY(-2px);
  }
  .mock {
    background: var(--surface-1);
    border-bottom: 1px solid var(--hair-1);
    padding: 14px 16px 16px;
    min-height: 132px;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  /* 产品窗口 chrome：与 hero 应用窗同一套三色点，让四张卡读作「产品截图」而非抽象示意 */
  .mock-chrome {
    display: flex;
    gap: 6px;
    margin-bottom: 8px;
  }
  .mock-chrome i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--hair-3);
  }
  .mock-chrome i:nth-child(1) {
    background: var(--dot-r);
  }
  .mock-chrome i:nth-child(2) {
    background: var(--dot-y);
  }
  .mock-chrome i:nth-child(3) {
    background: var(--dot-g);
  }
  /* 文档类 mock 的三种行：作品标题 / 带内联节标的成稿行 / 成稿段落。
     灰骨架条只表示「这里将来有字」，读者拿不到任何信息；换成真实文字后，四张卡
     讲的其实是同一批记录长成了四种产物——这条线索只有真文字才递得出去。
     区尾收束带那句（proof.band）就是这条线索的落点：同一批记录，长成四种你直接能用的东西。 */
  .mock .doc-h {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--text-1);
  }
  .mock .doc-l,
  .mock .doc-p {
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-2);
  }
  .mock .doc-l b {
    font-weight: 600;
    color: var(--text-3);
  }
  .mock .doc-l b::after {
    content: " · ";
    /* 「·」是渲染出来的字符，按 Ruling T4-3 走文字族而非发丝线 */
    color: var(--text-3);
  }
  .mock .mk-badge {
    display: inline-block;
    flex: none;
    font-family: var(--mono);
    font-size: var(--fs-micro);
    border-radius: 4px;
    padding: 2px 7px;
    background: var(--badge-meet-bg);
    color: var(--badge-meet);
  }
  .mock .mrow {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--text-2);
  }
  .mock .box {
    width: 13px;
    height: 13px;
    border: 1px solid var(--hair-2);
    border-radius: 3px;
    background: var(--surface-3);
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--fs-micro);
    color: var(--ok);
    font-family: var(--mono);
  }
  .mock .box.on {
    background: var(--badge-meet-bg);
    /* Task 5 复核留下的携带项（通则 3）：状态描边不能用 --accent-fill（压 --badge-meet-bg
       只 3.02、余量 0.02），改 --accent-400（4.76）；除这条注释外不动 Proofs.astro 别处。 */
    border-color: var(--accent-400);
  }
  .proof-body {
    padding: 20px 22px 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .proof-body .pname {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--accent-400);
    letter-spacing: 0.03em;
  }
  .proof-body h3 {
    font-size: 18px;
  }
  .proof-body p {
    font-size: 14px;
    /* 卡下的这句是「说明」不是「注」：按 spec §5.2 用途表走 --text-2
       （Ruling T4-4：用途表胜过 --muted→--text-3 的映射通则） */
    color: var(--text-2);
  }
  /* NB-7：全站唯一一次换底色落在这里；令牌是 --band，与被退役的 .band 类无关（NB-15） */
  .closer {
    margin-top: 56px;
    padding: 30px 0;
    background: var(--band);
  }
  .closer p {
    font-size: var(--fs-lead);
    color: var(--text-1);
    max-width: 720px;
  }
  @media (max-width: 760px) {
    .proof-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
