---
import type { Copy } from '@/lib/copy';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const proof = copy.proof;
---

<section class="band reveal" id="proofs">
  <div class="wrap">
    <div class="eyebrow">{proof.eyebrow}</div>
    <h2 class="h-2">{proof.title}</h2>
    <div class="proof-grid">
      <div class="proof-card wide">
        <div class="mock" data-shot="info-cards">
          <div class="mrow"><span class="mk-badge">{proof.m1t}</span><span>{proof.m1a}</span></div>
          <div class="mrow"><span class="mk-badge">{proof.m1b}</span><span>{proof.m1c}</span></div>
          <div class="mrow"><span class="mk-badge">{proof.m1d}</span><span>{proof.m1e}</span></div>
        </div>
        <div class="proof-body">
          <div class="pname">INFO CARDS</div>
          <h3>{proof['1t']}</h3>
          <p>{proof['1b']}</p>
        </div>
      </div>
      <div class="proof-card">
        <div class="mock" data-shot="todo">
          <div class="mrow"><span class="box on">✓</span><span>{proof.m2a}</span></div>
          <div class="mrow"><span class="box"></span><span>{proof.m2b}</span></div>
          <div class="mrow"><span class="box"></span><span>{proof.m2c}</span></div>
        </div>
        <div class="proof-body">
          <div class="pname">TO-DO LIST</div>
          <h3>{proof['2t']}</h3>
          <p>{proof['2b']}</p>
        </div>
      </div>
      <div class="proof-card">
        <div class="mock" data-shot="report">
          <div class="mrow"><span class="mk-badge">{proof.m3a}</span></div>
          <div class="docline" style="width:88%"></div>
          <div class="ml m"></div>
          <div class="ml s"></div>
          <div class="docline" style="width:64%"></div>
          <div class="ml xl"></div>
        </div>
        <div class="proof-body">
          <div class="pname">WEEKLY REPORT</div>
          <h3>{proof['3t']}</h3>
          <p>{proof['3b']}</p>
        </div>
      </div>
      <div class="proof-card">
        <div class="mock" data-shot="qa">
          <div class="q">{proof.m4q}</div>
          <div class="mrow"><span>{proof.m4a}</span><span class="cite">1</span><span class="cite">2</span><span class="cite">3</span></div>
          <div class="ml xl"></div>
          <div class="ml m"></div>
        </div>
        <div class="proof-body">
          <div class="pname">RETRIEVAL &amp; Q&amp;A</div>
          <h3>{proof['4t']}</h3>
          <p>{proof['4b']}</p>
        </div>
      </div>
      <div class="proof-card">
        <div class="mock" data-shot="creation">
          <div class="docline" style="width:40%;background:var(--ink);opacity:.75"></div>
          <div class="ml xl"></div>
          <div class="ml xl"></div>
          <div class="ml m"></div>
          <div class="mrow"><span class="mk-badge">{proof.m5a}</span><span>{proof.m5b}</span></div>
        </div>
        <div class="proof-body">
          <div class="pname">MAKING WORKS</div>
          <h3>{proof['5t']}</h3>
          <p>{proof['5b']}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* 此处 mock 为 CSS 示意，正式版换成真实产品截图。 */
  .proof-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-top: 44px;
  }
  .proof-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.18s, transform 0.18s;
  }
  .proof-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .proof-card.wide {
    grid-column: 1 / -1;
  }
  .mock {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    padding: 16px;
    min-height: 132px;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .mock .ml {
    height: 9px;
    border-radius: 3px;
    background: var(--line);
  }
  .mock .ml.s {
    width: 46%;
  }
  .mock .ml.m {
    width: 72%;
  }
  .mock .ml.xl {
    width: 90%;
  }
  .mock .mk-badge {
    display: inline-block;
    font-family: var(--mono);
    font-size: 10px;
    border-radius: 4px;
    padding: 2px 7px;
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
  .mock .mrow {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--ink-2);
  }
  .mock .box {
    width: 13px;
    height: 13px;
    border: 1px solid var(--line-2);
    border-radius: 3px;
    background: #fff;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    color: var(--ok);
    font-family: var(--mono);
  }
  .mock .box.on {
    background: var(--accent-soft);
    border-color: var(--accent);
  }
  .mock .cite {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 16px;
    height: 15px;
    border-radius: 4px;
    background: var(--accent-soft);
    color: var(--accent-ink);
    font-family: var(--mono);
    font-size: 9.5px;
    padding: 0 3px;
  }
  .mock .q {
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: #fff;
    padding: 5px 12px;
    font-size: 12px;
    color: var(--ink-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mock .docline {
    height: 7px;
    border-radius: 2px;
    background: var(--line);
    width: 100%;
  }
  .proof-body {
    padding: 20px 22px 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .proof-body .pname {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--accent);
    letter-spacing: 0.03em;
  }
  .proof-body h3 {
    font-size: 18px;
  }
  .proof-body p {
    font-size: 14px;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .proof-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
