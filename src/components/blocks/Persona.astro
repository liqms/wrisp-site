---
import type { Copy } from '@/lib/copy';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const persona = copy.persona;
const order: string[] = persona.order;
---

<section class="reveal" id="persona">
  <div class="wrap">
    <div class="eyebrow">{persona.eyebrow}</div>
    <h2 class="h-2">{persona.title}</h2>
    <p class="lead">{persona.lead}</p>

    <div class="persona">
      <div class="opts" role="group" aria-label={persona.group}>
        {order.map((id, index) => (
          <label class="opt">
            <input type="radio" name="persona" id={`p-${id}`} value={id} checked={index === 0} />
            <span>{persona.opts[id]}</span>
          </label>
        ))}
      </div>
      <div class="panels">
        {order.map((id) => (
          <div class="panel" data-id={id}>
            <div class="who">{persona.opts[id]}</div>
            <p class="sit">{persona.panels[id].sit}</p>
            <div class="jump">
              {persona.panels[id].links.map((link: { href: string; label: string }) => (
                <a class="btn btn-ghost btn-sm" href={link.href}>{link.label}</a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
  /*
   * 基态是四张平铺卡，一屏读完四档；只有支持 :has() 的浏览器才切成「点一档看一档」。
   * 这样退化不需要 JS，也不需要断点：拿不到 :has() 的抓取与旧内核看到更多内容，不是空白。
   * 选择器全部钉在 #persona 下，避免 is:global 渗到别的区块。
   */
  #persona .persona {
    margin-top: 34px;
  }
  #persona .opts {
    display: none;
    flex-wrap: wrap;
    gap: 10px;
  }
  #persona .opt {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--hair-2);
    border-radius: 999px;
    padding: 9px 16px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
    background: var(--surface-3);
    cursor: pointer;
    transition: border-color 0.18s, background 0.18s, color 0.18s;
  }
  #persona .opt:hover {
    border-color: var(--text-1);
  }
  /* 单选钮要能被键盘选中，所以是压看不见的 presence，而不是 display:none。 */
  #persona .opt input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  #persona .panels {
    margin-top: 14px;
  }
  #persona .panel {
    border: 1px solid var(--hair-1);
    border-left: 3px solid var(--accent-fill);
    border-radius: var(--r-card);
    background: var(--surface-2);
    padding: 20px 22px;
  }
  #persona .panel + .panel {
    margin-top: 12px;
  }
  #persona .who {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.03em;
    color: var(--accent-400);
    margin-bottom: 9px;
  }
  #persona .sit {
    font-size: 15.5px;
    color: var(--text-2);
    max-width: 680px;
  }
  #persona .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 16px;
  }

  @supports (selector(:has(*))) {
    #persona .opts {
      display: flex;
    }
    #persona .panels {
      margin-top: 16px;
    }
    #persona .panel {
      display: none;
      padding: 22px 24px;
    }
    /* 选项卡模式下选中的档名就在面板正上方，卡内那行小标题就成了逐字复读；
       基态（无 :has()）四张平铺卡没有别处可标身份，所以只在增强态里收掉。 */
    #persona .who {
      display: none;
    }
    #persona .persona:has(#p-notes:checked) .panel[data-id="notes"],
    #persona .persona:has(#p-write:checked) .panel[data-id="write"],
    #persona .persona:has(#p-manage:checked) .panel[data-id="manage"],
    #persona .persona:has(#p-twin:checked) .panel[data-id="twin"] {
      display: block;
    }
    #persona .opt:has(input:checked) {
      background: var(--surface-3);
      border-color: var(--accent-400);
      color: var(--accent-400);
    }
    #persona .opt:has(input:focus-visible) {
      outline: 2px solid var(--accent-300);
      outline-offset: 2px;
    }
  }
</style>
