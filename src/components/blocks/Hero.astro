---
import type { Copy } from '@/lib/copy';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
// 时态护栏住在扩展描述的后半句里：主标题讲终局，同一句的破折号之后讲当下能用上的部分。
const hero = copy.hero;
// 参与动画的句子都住 flow.json（不动的卡与卡标题住 proof.json）；hero 还供播放/暂停、窗口标题与麦克风来源等标签。
// 日期「10-22」与 CSS 类名是结构字段、不是文案，因此不走双语叶子。
const flow = copy.flow;
const stream = flow.stream;
const qa = flow.qa;
const lastFiled = stream.rows[stream.rows.length - 1];
// 两拍并成一行后，中文两拍直接相接；英文之间必须留一个真空格，它同时是词距和换行点。
const titleJoin = Astro.currentLocale === 'en' ? ' ' : '';

// 循环动画要的数据：语言已压平，随元素带下去，省掉一份平行字典。
const demo = {
  prefix: stream.prefix,
  // 暂停与挂载都要落回 SSR 终态的那一行，空闲句因此随 payload 下去。
  idle: stream.idle,
  today: hero.stream,
  dictated: hero.micSource,
  dictating: hero.micLabel,
  play: hero.play,
  pause: hero.pause,
  rows: stream.rows,
  incoming: stream.incoming,
};
---

<section class="hero">
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-copy">
        <h1 class="h-title">
          <span class="h-lead">{hero.title1}</span>{titleJoin}<span class="accent">{hero.title2}</span>
        </h1>
        <p class="lead">{hero.sub}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#next">{hero.cta1}</a>
        </div>
      </div>

      <div class="appwin">
        <div class="appwin-top">
          <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
          <span class="appwin-title">{hero.window}</span>
          <span class="appwin-ctl">
            <button type="button" id="streamToggle" aria-pressed="false" aria-controls="streamRows">{hero.pause}</button>
            <button type="button" id="qaToggle" aria-pressed="false" aria-controls="qaThread" hidden>{hero.pause}</button>
          </span>
        </div>
        <div class="demo-tabs" role="tablist" aria-label={hero.tabLabel}>
          <button type="button" role="tab" id="tab-flow" aria-controls="panel-flow" aria-selected="true" tabindex="0">{hero.tabFlow}</button>
          <button type="button" role="tab" id="tab-qa" aria-controls="panel-qa" aria-selected="false" tabindex="-1">{hero.tabQa}</button>
        </div>
        <div class="appwin-body">
          <div class="demo-panel" id="panel-flow" role="tabpanel" aria-labelledby="tab-flow">
            <div class="demo-flow" data-shot="hero-flow" data-demo={JSON.stringify(demo)}>
              <div class="stream">
                <div class="stream-head"><span>{hero.stream}</span><span class="mono">{stream.date}</span></div>
                <div class="stream-rows" id="streamRows" aria-live="polite" aria-relevant="additions">
                  {
                    stream.rows.map((row: any) => (
                      <div class="srow">
                        <span class="t">{row.time}</span>
                        <span class="txt">{row.text}</span>
                        <span class:list={['badge', row.cls]}>{row.badge}</span>
                      </div>
                    ))
                  }
                </div>
                <div class="typebar">
                  <div class="typing">
                    <span class="caret">▸</span>
                    <span class="txt" id="typebar">{stream.prefix}{stream.idle}</span>
                    <span class="cursor" id="cursor" aria-hidden="true"></span>
                  </div>
                  <span class="mic">{hero.mic}</span>
                </div>
              </div>
              <div class="cardpanel" id="cardPanel">
                <div class="card show" id="infoCard">
                  <div class="ch">
                    <span class="ct" id="cardType">{lastFiled.type}</span>
                    <span class:list={['badge', lastFiled.cls]} id="cardBadge">{lastFiled.badge}</span>
                  </div>
                  <div class="cbody" id="cardBody">{lastFiled.text}</div>
                  <div class="fld">
                    <b>{hero.fType}</b>
                    <span id="cardTypeV">{lastFiled.type}</span>
                  </div>
                  <div class="fld">
                    <b>{hero.fSource}</b>
                    <span id="cardSource">{lastFiled.time} · {hero.stream}</span>
                  </div>
                  <div class="fld">
                    <b>{hero.fStatus}</b>
                    <span id="cardStatus">{lastFiled.status}</span>
                  </div>
                </div>
                <span class="card-hint">{hero.cardhint}</span>
              </div>
            </div>
          </div>
          <div class="demo-panel" id="panel-qa" role="tabpanel" aria-labelledby="tab-qa" hidden>
            <div class="demo-qa" data-shot="hero-qa">
              <div class="qa-layout">
                <div class="qa-main">
                  <div class="qa-thread" id="qaThread">
                    <div class="qa-exchange">
                      <p class="qa-q" data-fade="1">{qa['1q']}</p>
                      <p class="qa-a" data-fade="2">{qa['1a']}<span class="cite">{qa['1c']}</span></p>
                    </div>
                    <div class="qa-exchange">
                      <p class="qa-q" data-fade="4">{qa['2q']}</p>
                      <p class="qa-a" data-fade="5">{qa['2a']}<span class="cite">{qa['2c']}</span></p>
                    </div>
                    <div class="qa-exchange">
                      <p class="qa-q" data-fade="7">{qa['3q']}</p>
                      <p class="qa-a" data-fade="8">{qa['3a']}<span class="cite">{qa['3c']}</span></p>
                    </div>
                    <div class="qa-exchange">
                      <p class="qa-q" data-fade="10">{qa['4q']}</p>
                      <p class="qa-a" data-fade="11">{qa['4a']}<span class="cite">{qa['4c']}</span></p>
                    </div>
                  </div>
                  <p class="qa-input" aria-hidden="true"><span class="caret">▸</span><span data-qa-input>{qa.input}</span></p>
                </div>
                <aside class="qa-sources" aria-label={qa.sources}>
                  <h4 class="qa-src-h">{qa.sources}</h4>
                  <div class="qa-src" data-fade="3">
                    <div class="qa-src-top"><span>{qa['1k']}</span><span>{qa['1t']}</span></div>
                    <p>{qa['1b']}</p>
                  </div>
                  <div class="qa-src" data-fade="6">
                    <div class="qa-src-top"><span>{qa['2k']}</span><span>{qa['2t']}</span></div>
                    <p>{qa['2b']}</p>
                  </div>
                  <div class="qa-src" data-fade="9">
                    <div class="qa-src-top"><span>{qa['3k']}</span><span>{qa['3t']}</span></div>
                    <p>{qa['3b']}</p>
                  </div>
                  <div class="qa-src" data-fade="12">
                    <div class="qa-src-top"><span>{qa['4k']}</span><span>{qa['4t']}</span></div>
                    <p>{qa['4b']}</p>
                  </div>
                </aside>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /*
   * 这里用 is:global 而不是 scoped：循环里新增的记录行与语音条是 JS 造的节点，
   * 拿不到 scoped 样式的作用域标记，scoped 写法会静默地选不中它们。
   * 选择器一律挂在 .hero / .appwin 下，不外溢。
   */
  .hero {
    padding-block: 72px 56px;
    /* 首屏极淡靛蓝柔光：强度远低于 11 区 CTA 的辉光，只给第一屏一点层次；重音仍交给 .accent 半句。
       原先叠的 22px 墨点阵随亮色体系删掉——ink 色点压在近黑底上不可见，要留这层质感得另立白色低透令牌。 */
    background: radial-gradient(560px 320px at 12% -8%, var(--glow-hero), transparent 70%);
  }
  /* 2026-11-04：文字区与演示窗改上下单列；窗内仍是记录流 / 卡片两栏，不受影响。 */
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 44px;
  }
  .hero .h-title {
    font-size: clamp(38px, 6vw, 62px);
  }
  /* 首屏文字区整体居中：标题、扩展描述、两枚按钮一条中线（参考站形态是居中两行 + 下方留白）。 */
  .hero .hero-copy {
    text-align: center;
  }
  /* .lead 自带 max-width:680px，不补 margin-inline 就把这段居中文字钉在列的左缘 */
  .hero .lead {
    margin-inline: auto;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
    align-items: center;
    justify-content: center;
  }
  /*
   * 主标题的两句是一拍让、一拍重：前半句退到次级墨并轻一档字重，重音整个交给后半句。
   * 淡在这里走实色令牌而不是 opacity——叠透明度会把对比度压到 WCAG AA 以下。
   * 整句读法仍是那句主口号，字没动，动的只有主次。
   */
  .hero .h-title .h-lead {
    color: var(--text-2);
    font-weight: 600;
  }
  .hero .h-title .accent {
    color: var(--accent-400);
  }
  /* 并成一行后，窄屏仍要一行读完一拍：CJK 默认任意汉字间都能断，会把「一个」劈成两半。
     锁住两拍内部，换行只发生在两句之间（英文的空格也在这里，所以词距不受影响）。 */
  .hero .h-title .h-lead,
  .hero .h-title .accent {
    white-space: nowrap;
  }
  /* ---------- 记录流窗口：首帧即终态，不靠 JS 才成型 ---------- */
  .appwin {
    position: relative;
    /* 卡投影整条删除（spec §5.1：层次只靠面与底的亮度差，不引入投影）；
       暗底上的墨色投影本就看不见，.appwin 改由 --surface-2 面差 + --hair-2 描边立起来。 */
    border: 1px solid var(--hair-2);
    border-radius: 14px;
    background: var(--surface-2);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    /* 参考 DeepSeek Harness：演示窗最宽 1020，1440 下左右各留 210 */
    width: 100%;
    max-width: 1020px;
    margin-inline: auto;
  }
  .appwin-top {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--hair-1);
    background: var(--surface-2);
  }
  .appwin-top .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--hair-2);
  }
  .appwin-top .dot.r {
    background: var(--dot-r);
  }
  .appwin-top .dot.y {
    background: var(--dot-y);
  }
  .appwin-top .dot.g {
    background: var(--dot-g);
  }
  .appwin-title {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-3);
    margin-left: 8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .appwin-ctl {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .appwin-ctl button {
    font-family: var(--mono);
    font-size: var(--fs-micro);
    /* 凸起按钮底是 --surface-3，--text-3 压其上只 4.19（11px 不在豁免内），抬到 --text-2 */
    color: var(--text-2);
    border: 1px solid var(--hair-1);
    background: var(--surface-3);
    border-radius: 999px;
    padding: 4px 10px;
    white-space: nowrap;
  }
  .appwin-ctl button:hover {
    color: var(--text-1);
    border-color: var(--hair-2);
  }
  .appwin-ctl button[hidden] {
    display: none;
  }
  /* 两段演示共用一扇窗：tab 条只做切换，不新增一层壳 */
  .demo-tabs {
    display: flex;
    gap: 4px;
    padding: 8px 12px;
    border-bottom: 1px solid var(--hair-1);
    background: var(--surface-2);
  }
  .demo-tabs button {
    appearance: none;
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-3);
    font-family: var(--mono);
    font-size: var(--fs-micro);
    line-height: 1;
    padding: 6px 11px;
    border-radius: 999px;
    cursor: pointer;
  }
  .demo-tabs button[aria-selected="true"] {
    color: var(--text-1);
    background: var(--surface-3);
    border-color: var(--hair-1);
  }
  .demo-tabs button:hover {
    color: var(--text-1);
  }
  .demo-tabs button:focus-visible {
    outline: 2px solid var(--accent-300);
    outline-offset: 2px;
  }
  .appwin-body {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr;
    flex: 1;
    min-height: 0;
    background: var(--surface-2);
  }
  .demo-panel {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .demo-panel[hidden] {
    display: none;
  }
  .demo-panel > .demo-flow,
  .demo-panel > .demo-qa {
    flex: 1;
    min-height: 0;
  }
  .appwin .demo-flow {
    display: grid;
    grid-template-columns: 1.22fr 0.78fr;
  }
  .appwin .stream {
    border-right: 1px solid var(--hair-1);
    padding: 18px;
    /* 固定高度下把输入条压到流底部：新增记录从下方进来，空白留在记录与输入条之间 */
    display: flex;
    flex-direction: column;
  }
  .appwin .stream-head {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-3);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 14px;
    display: flex;
    justify-content: space-between;
  }
  .appwin .stream-rows {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .appwin .srow {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    font-size: 13.5px;
    color: var(--text-2);
    border-radius: 6px;
    padding: 2px 4px;
  }
  .appwin .srow .t {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-3);
    margin-top: 3px;
    flex: none;
  }
  .appwin .srow .txt {
    flex: 1;
    min-width: 0;
  }
  .appwin .srow .badge {
    margin-top: 0;
  }
  .appwin .srow.landing {
    animation: land 0.5s ease;
  }
  @keyframes land {
    from {
      background: var(--surface-3);
    }
    to {
      background: transparent;
    }
  }
  .appwin .badge {
    display: inline-block;
    font-family: var(--mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.02em;
    border-radius: 5px;
    padding: 2px 7px;
    flex: none;
    white-space: nowrap;
  }
  .appwin .badge.todo {
    background: var(--badge-todo-bg);
    color: var(--badge-todo);
  }
  .appwin .badge.comp {
    background: var(--badge-comp-bg);
    color: var(--badge-comp);
  }
  .appwin .badge.meet {
    background: var(--badge-meet-bg);
    color: var(--badge-meet);
  }
  .appwin .badge.decide {
    background: var(--badge-decide-bg);
    color: var(--badge-decide);
  }
  .appwin .badge.need {
    background: var(--badge-need-bg);
    color: var(--badge-need);
  }
  /* 语音输入态：必须有可感知的「说话」形态 */
  .appwin .voice {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--accent-400);
    background: var(--surface-3);
    border: 1px dashed var(--accent-fill);
    border-radius: 8px;
    padding: 8px 12px;
    margin-top: 4px;
  }
  .appwin .voice .rec {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent-fill);
    animation: rec 1.1s ease infinite;
    flex: none;
  }
  @keyframes rec {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.25;
    }
  }
  .appwin .voice .wave {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 14px;
    flex: none;
  }
  .appwin .voice .wave i {
    width: 2px;
    background: var(--accent-fill);
    border-radius: 1px;
    animation: wv 1s ease-in-out infinite;
  }
  .appwin .voice .wave i:nth-child(1) {
    height: 5px;
    animation-delay: 0s;
  }
  .appwin .voice .wave i:nth-child(2) {
    height: 11px;
    animation-delay: 0.12s;
  }
  .appwin .voice .wave i:nth-child(3) {
    height: 7px;
    animation-delay: 0.24s;
  }
  .appwin .voice .wave i:nth-child(4) {
    height: 13px;
    animation-delay: 0.36s;
  }
  .appwin .voice .wave i:nth-child(5) {
    height: 6px;
    animation-delay: 0.48s;
  }
  @keyframes wv {
    0%,
    100% {
      transform: scaleY(0.5);
    }
    50% {
      transform: scaleY(1);
    }
  }
  .appwin .voice .dur {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--accent-400);
    margin-left: auto;
    flex: none;
  }
  .appwin .typebar {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 13px;
    color: var(--text-2);
    border-top: 1px dashed var(--hair-1);
    margin-top: auto;
    padding-top: 14px;
  }
  .appwin .typebar .typing {
    display: flex;
    align-items: flex-start;
    gap: 9px;
  }
  .appwin .typebar .caret {
    color: var(--accent-400);
    font-family: var(--mono);
    flex: none;
    line-height: 1.5;
  }
  .appwin .typebar .txt {
    flex: 1;
    min-width: 0;
    min-height: 20px;
  }
  .appwin .typebar .mic {
    color: var(--text-3);
    font-family: var(--mono);
    font-size: 11px;
    text-align: right;
  }
  .appwin .typebar .cursor {
    display: inline-block;
    width: 8px;
    height: 16px;
    background: var(--accent-fill);
    vertical-align: -2px;
    flex: none;
    margin-top: 3px;
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .appwin .cardpanel {
    padding: 14px;
    background: var(--surface-1);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .appwin .card {
    display: none;
    flex-direction: column;
    gap: 10px;
    border: 1px solid var(--hair-1);
    border-radius: var(--r-sm);
    padding: 13px;
    background: var(--surface-3);
  }
  .appwin .card.show {
    display: flex;
  }
  .appwin .card.flip {
    animation: cardin 0.45s ease;
  }
  @keyframes cardin {
    from {
      opacity: 0.4;
      transform: translateY(8px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .appwin .card .ch {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .appwin .card .ct {
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
  }
  .appwin .card .cbody {
    font-size: 13.5px;
    color: var(--text-2);
  }
  .appwin .card .fld {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 8px;
    font-size: 12px;
    border-top: 1px solid var(--hair-1);
    padding-top: 8px;
  }
  .appwin .card .fld b {
    font-family: var(--mono);
    font-weight: 500;
    /* 卡底是 --surface-3，--muted 常规映射到 --text-3，但 11px 压其上只 4.19，
       不在 ≥24px 豁免内，抬到 --text-2（6.99） */
    color: var(--text-2);
    font-size: 11px;
  }
  .appwin .card .fld span {
    color: var(--text-2);
    text-align: right;
    overflow-wrap: anywhere;
  }
  .appwin .card-hint {
    margin-top: auto;
    font-size: 11.5px;
    color: var(--text-3);
    font-family: var(--mono);
  }

  /* ---------- 问答段：左对话、右来源卡；输入框固定在主内容区底部 ---------- */
  .appwin .demo-qa {
    display: flex;
    flex-direction: column;
    padding: 0;
  }
  .qa-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    height: 100%;
    min-height: 0;
  }
  .qa-main {
    display: flex;
    flex-direction: column;
    min-height: 0;
    border-right: 1px solid var(--hair-1);
  }
  .qa-thread {
    flex: 1;
    min-height: 0;
    overflow: auto;
    padding: 16px 18px 10px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .qa-exchange {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .qa-q {
    align-self: flex-end;
    max-width: 88%;
    padding: 7px 10px;
    border: 1px solid var(--hair-1);
    border-radius: 10px 10px 2px 10px;
    background: var(--surface-3);
    color: var(--text-1);
    font-size: 12.5px;
    line-height: 1.45;
  }
  .qa-a {
    max-width: 94%;
    color: var(--text-2);
    font-size: 12.5px;
    line-height: 1.55;
  }
  .qa-a .cite {
    margin-left: 6px;
    font-family: var(--mono);
    font-size: var(--fs-mono);
    color: var(--accent-400);
    white-space: nowrap;
  }
  .qa-input {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 18px 14px;
    padding-top: 10px;
    border-top: 1px dashed var(--hair-1);
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--text-3);
  }
  .qa-input .caret {
    color: var(--accent-400);
    flex: none;
  }
  .qa-sources {
    min-height: 0;
    overflow: auto;
    padding: 16px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .qa-src-h {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .qa-src {
    border: 1px solid var(--hair-1);
    border-radius: 8px;
    background: var(--surface-3);
    padding: 8px 10px;
  }
  .qa-src-top {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--accent-400);
  }
  .qa-src p {
    margin-top: 4px;
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--text-2);
  }
  .js .appwin .demo-qa.demo-running [data-fade] {
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .js .appwin .demo-qa.demo-running [data-fade].demo-in {
    opacity: 1;
  }
  /* 对话是逐句长出来的：未轮到的句子不占位，线程才能从底部持续上推 */
  .js .appwin .demo-qa.demo-running .qa-q[data-fade],
  .js .appwin .demo-qa.demo-running .qa-a[data-fade],
  .js .appwin .demo-qa.demo-running .qa-src[data-fade] {
    display: none;
  }
  .js .appwin .demo-qa.demo-running .qa-q[data-fade].demo-in,
  .js .appwin .demo-qa.demo-running .qa-a[data-fade].demo-in,
  .js .appwin .demo-qa.demo-running .qa-src[data-fade].demo-in {
    display: block;
    animation: qaIn 0.25s ease;
  }
  @keyframes qaIn {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .js .appwin .srow.living {
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .js .appwin .srow.living.show {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    /* 动画不可用时，静态终态就是全部内容，连暂停键一起撤掉 */
    .appwin-ctl {
      display: none;
    }
  }
  @media (max-width: 640px) {
    /* 移动端退化：日志流只留左侧流，右侧卡片栏整栏隐藏 */
    .appwin .demo-flow {
      grid-template-columns: 1fr;
    }
    .appwin .stream {
      border-right: 0;
      border-bottom: 0;
    }
    .appwin .cardpanel {
      display: none;
    }
    .appwin-ctl {
      display: none;
    }
    .hero-actions .btn {
      width: 100%;
    }
    /* 两段演示共窗：tab 切换时窗高不跳；600 能装下堆叠后的日志流 */
    .appwin {
      height: 600px;
    }
    /* 问答窄屏只留主对话：右侧来源栏整栏隐藏；出处仍在每条答案的角标里 */
    .qa-layout {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr;
    }
    .qa-main {
      border-right: 0;
      border-bottom: 0;
    }
    .qa-sources {
      display: none;
    }
  }
  /*
   * 两段演示共用一扇窗：tab 只切面板，窗高固定，切 tab 不推页面。
   * 高度取 500：日志流 5 行放得下，四组问答的中英对话也刚好不裁。
   * 移动端 600：堆叠后的日志流更高；切 tab 仍不跳。
   */
  @media (min-width: 641px) {
    .appwin {
      height: 500px;
    }
  }
</style>

<script>
  import { mountDemo, type DemoRuntime } from '../../lib/demo-driver';

  const flowFace = document.querySelector<HTMLElement>('.demo-flow');
  const payload = flowFace?.dataset.demo;
  if (flowFace && payload) {
    type Scene = {
      time: string;
      mode: string;
      badge: string;
      cls: string;
      text: string;
      type: string;
      status: string;
      dur?: string;
    };
    const demo = JSON.parse(payload) as {
      prefix: string;
      idle: string;
      today: string;
      dictated: string;
      dictating: string;
      play: string;
      pause: string;
      rows: Scene[];
      incoming: Scene[];
    };

    const rowsBox = document.getElementById('streamRows')!;
    const typebar = document.getElementById('typebar')!;
    const card = document.getElementById('infoCard')!;
    const cardType = document.getElementById('cardType')!;
    const cardTypeV = document.getElementById('cardTypeV')!;
    const cardBody = document.getElementById('cardBody')!;
    const cardBadge = document.getElementById('cardBadge')!;
    const cardSource = document.getElementById('cardSource')!;
    const cardStatus = document.getElementById('cardStatus')!;

    const rowEl = (scene: Scene, landing: boolean) => {
      const node = document.createElement('div');
      node.className = landing ? 'srow landing' : 'srow';
      const time = document.createElement('span');
      time.className = 't';
      time.textContent = scene.time;
      const text = document.createElement('span');
      text.className = 'txt';
      text.textContent = scene.text;
      const badge = document.createElement('span');
      badge.className = `badge ${scene.cls}`;
      badge.textContent = scene.badge;
      node.append(time, text, badge);
      return node;
    };

    // 无 JS 与 reduced-motion 都到不了这里（驱动早退），所以 flip 无需再问一次 reduced。
    const setCard = (scene: Scene) => {
      cardType.textContent = scene.type;
      cardTypeV.textContent = scene.type;
      cardBody.textContent = scene.text;
      cardBadge.className = `badge ${scene.cls}`;
      cardBadge.textContent = scene.badge;
      cardSource.textContent = `${scene.time} · ${scene.mode === 'voice' ? demo.dictated : demo.today}`;
      cardStatus.textContent = scene.status;
      card.classList.add('show');
      card.classList.remove('flip');
      void card.offsetWidth;
      card.classList.add('flip');
    };

    const renderFrame = () => {
      rowsBox.textContent = '';
      // 回帧要与 SSR 终态逐字一致，否则暂停会停在没有文字的语音条上。
      typebar.textContent = demo.prefix + demo.idle;
      for (const scene of demo.rows) rowsBox.appendChild(rowEl(scene, false));
      setCard(demo.rows[demo.rows.length - 1]!);
    };

    const showVoice = (scene: Scene) => {
      const node = document.createElement('div');
      node.className = 'voice';
      const rec = document.createElement('span');
      rec.className = 'rec';
      const label = document.createElement('span');
      label.textContent = demo.dictating;
      const wave = document.createElement('span');
      wave.className = 'wave';
      wave.setAttribute('aria-hidden', 'true'); // 装饰性中间帧才挂 aria-hidden
      for (let i = 0; i < 5; i++) wave.appendChild(document.createElement('i'));
      const dur = document.createElement('span');
      dur.className = 'dur';
      dur.textContent = scene.dur ?? '';
      node.append(rec, label, wave, dur);
      rowsBox.appendChild(node);
      return node;
    };

    const typeInto = (rt: DemoRuntime, full: string) => {
      let k = 0;
      const step = () => {
        typebar.textContent = full.slice(0, k);
        if (k >= full.length) return;
        k += 1;
        rt.at(26, step);
      };
      step();
    };

    // 演示一：SSR 已经交出终态（三条记录 + 一张展开卡片），循环只做增量。
    // watch 用本面板而不是 .hero：切到问答 tab 后 display:none，观察器会把本演示暂停。
    mountDemo({
      root: flowFace,
      watch: flowFace,
      toggle: document.getElementById('streamToggle'),
      labels: { play: demo.play, pause: demo.pause },
      reset: () => renderFrame(),
      run(rt) {
        const total = demo.incoming.length;
        let n = 0;
        const next = () => {
          const scene = demo.incoming[n % total]!;
          const voice = scene.mode === 'voice' ? showVoice(scene) : null;
          if (!voice) typeInto(rt, demo.prefix + scene.text);
          rt.at(voice ? 2400 : 1200, () => {
            voice?.remove();
            typebar.textContent = '';
            const node = rowEl(scene, true);
            node.classList.add('living');
            rowsBox.appendChild(node);
            requestAnimationFrame(() => node.classList.add('show'));
            setCard(scene);
            n += 1;
            rt.at(rt.stepMs, n % total === 0 ? () => rt.loop() : next);
          });
        };
        rt.at(2200, next);
      },
    });

    // 演示二：四组问答。输入框逐字打出问题，问句落进对话，答句与来源卡随后出现。
    const qaThread = document.getElementById('qaThread');
    const qaInput = document.querySelector<HTMLElement>('[data-qa-input]');
    const qaPlaceholder = qaInput?.textContent ?? '';
    const exchanges = Array.from(document.querySelectorAll<HTMLElement>('.qa-exchange'));
    const sources = Array.from(document.querySelectorAll<HTMLElement>('.qa-src'));
    const scrollQa = () => {
      if (qaThread) qaThread.scrollTop = qaThread.scrollHeight;
    };
    const typeQuestion = (rt: DemoRuntime, text: string, done: () => void) => {
      if (!qaInput) {
        done();
        return;
      }
      let i = 0;
      const step = () => {
        qaInput.textContent = text.slice(0, i);
        if (i >= text.length) {
          done();
          return;
        }
        i += 1;
        rt.at(24, step);
      };
      step();
    };
    mountDemo({
      root: document.querySelector<HTMLElement>('.demo-qa')!,
      toggle: document.getElementById('qaToggle'),
      labels: { play: demo.play, pause: demo.pause },
      reset(rt) {
        rt.none();
        if (qaInput) qaInput.textContent = qaPlaceholder;
        if (qaThread) qaThread.scrollTop = 0;
      },
      run(rt) {
        const step = (i: number) => {
          const ex = exchanges[i];
          if (!ex) {
            rt.at(2600, () => rt.loop());
            return;
          }
          const qEl = ex.querySelector<HTMLElement>('.qa-q');
          const aEl = ex.querySelector<HTMLElement>('.qa-a');
          const src = sources[i];
          typeQuestion(rt, qEl?.textContent?.trim() ?? '', () => {
            if (qEl) rt.show(qEl);
            if (qaInput) qaInput.textContent = qaPlaceholder;
            scrollQa();
            rt.at(650, () => {
              if (aEl) rt.show(aEl);
              if (src) rt.show(src);
              scrollQa();
              rt.at(1900, () => step(i + 1));
            });
          });
        };
        step(0);
      },
    });

    // 两个 demo 共用一扇窗，tab 只切面板；隐藏面板的交互动效交给观察器暂停。
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.demo-tabs [role="tab"]'));
    const panelFor = (tab: HTMLButtonElement) =>
      document.getElementById(tab.getAttribute('aria-controls') || '');
    const pauseFor: Record<string, HTMLElement | null> = {
      'tab-flow': document.getElementById('streamToggle'),
      'tab-qa': document.getElementById('qaToggle'),
    };
    const activate = (tab: HTMLButtonElement) => {
      for (const item of tabs) {
        const selected = item === tab;
        item.setAttribute('aria-selected', String(selected));
        item.tabIndex = selected ? 0 : -1;
        const panel = panelFor(item);
        if (panel) panel.hidden = !selected;
        if (pauseFor[item.id]) pauseFor[item.id]!.hidden = !selected;
      }
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(tab));
      tab.addEventListener('keydown', (event) => {
        const key = event.key;
        if (key !== 'ArrowLeft' && key !== 'ArrowRight' && key !== 'Home' && key !== 'End') return;
        event.preventDefault();
        const next =
          key === 'Home'
            ? tabs[0]
            : key === 'End'
              ? tabs[tabs.length - 1]
              : tabs[(index + (key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length];
        if (next) {
          activate(next);
          next.focus();
        }
      });
    });
    activate(tabs[0]!);
  }
</script>
