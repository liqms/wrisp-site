---
import type { Copy } from '@/lib/copy';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
// hero.guard 是时态护栏：主标题讲终局，紧跟一行讲当下能用上的部分。
const hero = copy.hero;
// 参与动画的句子都住 flow.json（不动的卡与卡标题住 proof.json），只有两条「来源」标签仍从 hero 取；
// 日期「10-22」与 CSS 类名是结构字段、不是文案，因此不走双语叶子。
const flow = copy.flow;
const stream = flow.stream;
const lastFiled = stream.rows[stream.rows.length - 1];

// 循环动画要的数据：语言已压平，随元素带下去，省掉一份平行字典。
const demo = {
  prefix: stream.prefix,
  today: hero.stream,
  dictated: hero.micSource,
  dictating: hero.micLabel,
  play: hero.play,
  pause: hero.pause,
  rows: stream.rows,
  incoming: stream.incoming,
};
---

<section class="hero">
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">{hero.kicker}</div>
        <h1 class="h-title">
          <span class="h-lead">{hero.title1}</span><br />
          <span class="accent">{hero.title2}</span>
        </h1>
        <p class="lead">{hero.sub}</p>
        <p class="situation">{hero.situation}</p>
        <p class="guard">{hero.guard}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#next">{hero.cta1}</a>
          <a class="btn btn-ghost" href="#how">{hero.cta2}</a>
        </div>
      </div>

      <div class="appwin" data-demo={JSON.stringify(demo)}>
        <div class="appwin-top">
          <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
          <span class="appwin-title">{hero.window}</span>
          <span class="appwin-ctl">
            <button type="button" id="streamToggle" aria-pressed="false">{hero.pause}</button>
          </span>
        </div>
        <div class="appwin-body">
          <div class="stream">
            <div class="stream-head"><span>{hero.stream}</span><span class="mono">{stream.date}</span></div>
            <div class="stream-rows" id="streamRows" aria-live="polite" aria-relevant="additions">
              {
                stream.rows.map((row: any) => (
                  <div class="srow">
                    <span class="t">{row.time}</span>
                    <span class="txt">{row.text}</span>
                    <span class:list={['badge', row.cls]}>{row.badge}</span>
                  </div>
                ))
              }
            </div>
            <div class="typebar">
              <div class="typing">
                <span class="caret">▸</span>
                <span class="txt" id="typebar">{stream.prefix}{stream.idle}</span>
                <span class="cursor" id="cursor" aria-hidden="true"></span>
              </div>
              <span class="mic">{hero.mic}</span>
            </div>
          </div>
          <div class="cardpanel" id="cardPanel">
            <div class="card show" id="infoCard">
              <div class="ch">
                <span class="ct" id="cardType">{lastFiled.type}</span>
                <span class:list={['badge', lastFiled.cls]} id="cardBadge">{lastFiled.badge}</span>
              </div>
              <div class="cbody" id="cardBody">{lastFiled.text}</div>
              <div class="fld">
                <b>{hero.fType}</b>
                <span id="cardTypeV">{lastFiled.type}</span>
              </div>
              <div class="fld">
                <b>{hero.fSource}</b>
                <span id="cardSource">{lastFiled.time} · {hero.stream}</span>
              </div>
              <div class="fld">
                <b>{hero.fStatus}</b>
                <span id="cardStatus">{lastFiled.status}</span>
              </div>
            </div>
            <span class="card-hint">{hero.cardhint}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /*
   * 这里用 is:global 而不是 scoped：循环里新增的记录行与语音条是 JS 造的节点，
   * 拿不到 scoped 样式的作用域标记，scoped 写法会静默地选不中它们。
   * 选择器一律挂在 .hero / .appwin 下，不外溢。
   */
  .hero {
    padding-block: 72px 56px;
    /* 首屏极淡靛蓝柔光：强度远低于 11 区 CTA 的辉光，只给第一屏一点层次；重音仍交给 .accent 半句。
       原先叠的 22px 墨点阵随亮色体系删掉——ink 色点压在近黑底上不可见，要留这层质感得另立白色低透令牌。 */
    background: radial-gradient(560px 320px at 12% -8%, var(--glow-hero), transparent 70%);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
  }
  .hero .h-title {
    font-size: clamp(38px, 6vw, 62px);
  }
  /*
   * 主标题的两句是一拍让、一拍重：前半句退到次级墨并轻一档字重，重音整个交给后半句。
   * 淡在这里走实色令牌而不是 opacity——叠透明度会把对比度压到 WCAG AA 以下。
   * 整句读法仍是那句主口号，字没动，动的只有主次。
   */
  .hero .h-title .h-lead {
    color: var(--text-2);
    font-weight: 600;
  }
  .hero .h-title .accent {
    color: var(--accent-400);
  }
  .hero .situation {
    margin-top: 12px;
    max-width: 640px;
    /* §4.1：--text-2 一行、--fs-lead 档；三段中点分隔，不加句号 */
    font-size: var(--fs-lead);
    color: var(--text-2);
  }
  .hero .guard {
    margin-top: 14px;
    max-width: 560px;
    font-size: 15.5px;
    color: var(--text-2);
    border-left: 2px solid var(--accent-fill);
    padding-left: 14px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
    align-items: center;
  }

  /* ---------- 记录流窗口：首帧即终态，不靠 JS 才成型 ---------- */
  .appwin {
    position: relative;
    /* 卡投影整条删除（spec §5.1：层次只靠面与底的亮度差，不引入投影）；
       暗底上的墨色投影本就看不见，.appwin 改由 --surface-2 面差 + --hair-2 描边立起来。 */
    border: 1px solid var(--hair-2);
    border-radius: 14px;
    background: var(--surface-2);
    overflow: hidden;
  }
  .appwin-top {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--hair-1);
    background: var(--surface-2);
  }
  .appwin-top .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--hair-2);
  }
  .appwin-top .dot.r {
    background: var(--dot-r);
  }
  .appwin-top .dot.y {
    background: var(--dot-y);
  }
  .appwin-top .dot.g {
    background: var(--dot-g);
  }
  .appwin-title {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-3);
    margin-left: 8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .appwin-ctl {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .appwin-ctl button {
    font-family: var(--mono);
    font-size: var(--fs-micro);
    /* 凸起按钮底是 --surface-3，--text-3 压其上只 4.19（11px 不在豁免内），抬到 --text-2 */
    color: var(--text-2);
    border: 1px solid var(--hair-1);
    background: var(--surface-3);
    border-radius: 999px;
    padding: 4px 10px;
    white-space: nowrap;
  }
  .appwin-ctl button:hover {
    color: var(--text-1);
    border-color: var(--hair-2);
  }
  .appwin-body {
    display: grid;
    grid-template-columns: 1.22fr 0.78fr;
    background: var(--surface-2);
  }
  .appwin .stream {
    border-right: 1px solid var(--hair-1);
    padding: 18px;
  }
  .appwin .stream-head {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-3);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 14px;
    display: flex;
    justify-content: space-between;
  }
  .appwin .stream-rows {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .appwin .srow {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    font-size: 13.5px;
    color: var(--text-2);
    border-radius: 6px;
    padding: 2px 4px;
  }
  .appwin .srow .t {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-3);
    margin-top: 3px;
    flex: none;
  }
  .appwin .srow .txt {
    flex: 1;
    min-width: 0;
  }
  .appwin .srow .badge {
    margin-top: 0;
  }
  .appwin .srow.landing {
    animation: land 0.5s ease;
  }
  @keyframes land {
    from {
      background: var(--surface-3);
    }
    to {
      background: transparent;
    }
  }
  .appwin .badge {
    display: inline-block;
    font-family: var(--mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.02em;
    border-radius: 5px;
    padding: 2px 7px;
    flex: none;
    white-space: nowrap;
  }
  .appwin .badge.todo {
    background: var(--badge-todo-bg);
    color: var(--badge-todo);
  }
  .appwin .badge.comp {
    background: var(--badge-comp-bg);
    color: var(--badge-comp);
  }
  .appwin .badge.meet {
    background: var(--badge-meet-bg);
    color: var(--badge-meet);
  }
  .appwin .badge.decide {
    background: var(--badge-decide-bg);
    color: var(--badge-decide);
  }
  .appwin .badge.need {
    background: var(--badge-need-bg);
    color: var(--badge-need);
  }
  /* 语音输入态：必须有可感知的「说话」形态 */
  .appwin .voice {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--accent-400);
    background: var(--surface-3);
    border: 1px dashed var(--accent-fill);
    border-radius: 8px;
    padding: 8px 12px;
    margin-top: 4px;
  }
  .appwin .voice .rec {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent-fill);
    animation: rec 1.1s ease infinite;
    flex: none;
  }
  @keyframes rec {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.25;
    }
  }
  .appwin .voice .wave {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 14px;
    flex: none;
  }
  .appwin .voice .wave i {
    width: 2px;
    background: var(--accent-fill);
    border-radius: 1px;
    animation: wv 1s ease-in-out infinite;
  }
  .appwin .voice .wave i:nth-child(1) {
    height: 5px;
    animation-delay: 0s;
  }
  .appwin .voice .wave i:nth-child(2) {
    height: 11px;
    animation-delay: 0.12s;
  }
  .appwin .voice .wave i:nth-child(3) {
    height: 7px;
    animation-delay: 0.24s;
  }
  .appwin .voice .wave i:nth-child(4) {
    height: 13px;
    animation-delay: 0.36s;
  }
  .appwin .voice .wave i:nth-child(5) {
    height: 6px;
    animation-delay: 0.48s;
  }
  @keyframes wv {
    0%,
    100% {
      transform: scaleY(0.5);
    }
    50% {
      transform: scaleY(1);
    }
  }
  .appwin .voice .dur {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--accent-400);
    margin-left: auto;
    flex: none;
  }
  .appwin .typebar {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 13px;
    color: var(--text-2);
    border-top: 1px dashed var(--hair-1);
    margin-top: 16px;
    padding-top: 14px;
  }
  .appwin .typebar .typing {
    display: flex;
    align-items: flex-start;
    gap: 9px;
  }
  .appwin .typebar .caret {
    color: var(--accent-400);
    font-family: var(--mono);
    flex: none;
    line-height: 1.5;
  }
  .appwin .typebar .txt {
    flex: 1;
    min-width: 0;
    min-height: 20px;
  }
  .appwin .typebar .mic {
    color: var(--text-3);
    font-family: var(--mono);
    font-size: 11px;
    text-align: right;
  }
  .appwin .typebar .cursor {
    display: inline-block;
    width: 8px;
    height: 16px;
    background: var(--accent-fill);
    vertical-align: -2px;
    flex: none;
    margin-top: 3px;
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .appwin .cardpanel {
    padding: 14px;
    background: var(--surface-1);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .appwin .card {
    display: none;
    flex-direction: column;
    gap: 10px;
    border: 1px solid var(--hair-1);
    border-radius: var(--r-sm);
    padding: 13px;
    background: var(--surface-3);
  }
  .appwin .card.show {
    display: flex;
  }
  .appwin .card.flip {
    animation: cardin 0.45s ease;
  }
  @keyframes cardin {
    from {
      opacity: 0.4;
      transform: translateY(8px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .appwin .card .ch {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .appwin .card .ct {
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
  }
  .appwin .card .cbody {
    font-size: 13.5px;
    color: var(--text-2);
  }
  .appwin .card .fld {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 8px;
    font-size: 12px;
    border-top: 1px solid var(--hair-1);
    padding-top: 8px;
  }
  .appwin .card .fld b {
    font-family: var(--mono);
    font-weight: 500;
    /* 卡底是 --surface-3，--muted 常规映射到 --text-3，但 11px 压其上只 4.19，
       不在 ≥24px 豁免内，抬到 --text-2（6.99） */
    color: var(--text-2);
    font-size: 11px;
  }
  .appwin .card .fld span {
    color: var(--text-2);
    text-align: right;
    overflow-wrap: anywhere;
  }
  .appwin .card-hint {
    font-size: 11.5px;
    color: var(--text-3);
    font-family: var(--mono);
  }

  .js .appwin .srow.living {
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .js .appwin .srow.living.show {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    /* 动画不可用时，静态终态就是全部内容，连暂停键一起撤掉 */
    .appwin-ctl {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
  @media (max-width: 640px) {
    /* 移动端退化：静态流 + 卡片，不参与循环 */
    .appwin-body {
      grid-template-columns: 1fr;
    }
    .appwin .stream {
      border-right: 0;
      border-bottom: 1px solid var(--hair-1);
    }
    .appwin-ctl {
      display: none;
    }
    .hero-actions .btn {
      width: 100%;
    }
  }
</style>

<script>
  import { mountDemo, type DemoRuntime } from '../../lib/demo-driver';

  const win = document.querySelector<HTMLElement>('.appwin');
  const payload = win?.dataset.demo;
  if (win && payload) {
    type Scene = {
      time: string;
      mode: string;
      badge: string;
      cls: string;
      text: string;
      type: string;
      status: string;
      dur?: string;
    };
    const demo = JSON.parse(payload) as {
      prefix: string;
      today: string;
      dictated: string;
      dictating: string;
      play: string;
      pause: string;
      rows: Scene[];
      incoming: Scene[];
    };

    const rowsBox = document.getElementById('streamRows')!;
    const typebar = document.getElementById('typebar')!;
    const card = document.getElementById('infoCard')!;
    const cardType = document.getElementById('cardType')!;
    const cardTypeV = document.getElementById('cardTypeV')!;
    const cardBody = document.getElementById('cardBody')!;
    const cardBadge = document.getElementById('cardBadge')!;
    const cardSource = document.getElementById('cardSource')!;
    const cardStatus = document.getElementById('cardStatus')!;

    const rowEl = (scene: Scene, landing: boolean) => {
      const node = document.createElement('div');
      node.className = landing ? 'srow landing' : 'srow';
      const time = document.createElement('span');
      time.className = 't';
      time.textContent = scene.time;
      const text = document.createElement('span');
      text.className = 'txt';
      text.textContent = scene.text;
      const badge = document.createElement('span');
      badge.className = `badge ${scene.cls}`;
      badge.textContent = scene.badge;
      node.append(time, text, badge);
      return node;
    };

    // 无 JS 与 reduced-motion 都到不了这里（驱动早退），所以 flip 无需再问一次 reduced。
    const setCard = (scene: Scene) => {
      cardType.textContent = scene.type;
      cardTypeV.textContent = scene.type;
      cardBody.textContent = scene.text;
      cardBadge.className = `badge ${scene.cls}`;
      cardBadge.textContent = scene.badge;
      cardSource.textContent = `${scene.time} · ${scene.mode === 'voice' ? demo.dictated : demo.today}`;
      cardStatus.textContent = scene.status;
      card.classList.add('show');
      card.classList.remove('flip');
      void card.offsetWidth;
      card.classList.add('flip');
    };

    const renderFrame = () => {
      rowsBox.textContent = '';
      for (const scene of demo.rows) rowsBox.appendChild(rowEl(scene, false));
      setCard(demo.rows[demo.rows.length - 1]);
    };

    const showVoice = (scene: Scene) => {
      const node = document.createElement('div');
      node.className = 'voice';
      const rec = document.createElement('span');
      rec.className = 'rec';
      const label = document.createElement('span');
      label.textContent = demo.dictating;
      const wave = document.createElement('span');
      wave.className = 'wave';
      wave.setAttribute('aria-hidden', 'true'); // 装饰性中间帧才挂 aria-hidden
      for (let i = 0; i < 5; i++) wave.appendChild(document.createElement('i'));
      const dur = document.createElement('span');
      dur.className = 'dur';
      dur.textContent = scene.dur ?? '';
      node.append(rec, label, wave, dur);
      rowsBox.appendChild(node);
      return node;
    };

    const typeInto = (rt: DemoRuntime, full: string) => {
      let k = 0;
      const step = () => {
        typebar.textContent = full.slice(0, k);
        if (k >= full.length) return;
        k += 1;
        rt.at(26, step);
      };
      step();
    };

    // 演示一：SSR 已经交出终态（三条记录 + 一张展开卡片），循环只做增量。
    mountDemo({
      root: win,
      watch: document.querySelector<HTMLElement>('.hero') ?? undefined,
      toggle: document.getElementById('streamToggle'),
      labels: { play: demo.play, pause: demo.pause },
      reset: () => renderFrame(),
      run(rt) {
        const total = demo.incoming.length;
        let n = 0;
        const next = () => {
          const scene = demo.incoming[n % total]!;
          const voice = scene.mode === 'voice' ? showVoice(scene) : null;
          if (!voice) typeInto(rt, demo.prefix + scene.text);
          rt.at(voice ? 2400 : 1200, () => {
            voice?.remove();
            typebar.textContent = '';
            const node = rowEl(scene, true);
            node.classList.add('living');
            rowsBox.appendChild(node);
            requestAnimationFrame(() => node.classList.add('show'));
            setCard(scene);
            n += 1;
            rt.at(rt.stepMs, n % total === 0 ? () => rt.loop() : next);
          });
        };
        rt.at(2200, next);
      },
    });
  }
</script>
