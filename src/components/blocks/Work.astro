---
import type { Copy } from '@/lib/copy';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const work = copy.work;
---

<section class="band reveal" id="how">
  <div class="wrap">
    <div class="eyebrow">{work.eyebrow}</div>
    <h2 class="h-2">{work.title}</h2>
    <p class="lead">{work.sub}</p>
    <div class="steps">
      <div class="step current">
        <div class="snum" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0"/><path d="M12 18v3"/></svg></div>
        <h3>{work['1t']}</h3>
        <p>{work['1b']}</p>
      </div>
      <div class="step">
        <div class="snum" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h5l2 2h11v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"/></svg></div>
        <h3>{work['2t']}</h3>
        <p>{work['2b']}</p>
      </div>
      <div class="step">
        <div class="snum" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="6"/><path d="M15.5 15.5 21 21"/></svg></div>
        <h3>{work['3t']}</h3>
        <p>{work['3b']}</p>
      </div>
      <div class="step">
        <div class="snum" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V7z"/><path d="M14 3v4h4"/></svg></div>
        <h3>{work['4t']}</h3>
        <p>{work['4b']}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin-top: 44px;
    position: relative;
  }
  .step {
    padding: 0 18px;
    position: relative;
  }
  .step:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 22px;
    left: calc(100% - 18px);
    width: calc(2 * 18px);
    height: 1px;
    /* 步骤之间的连接线是装饰线，走发丝族 */
    background: var(--hair-2);
  }
  .step .snum {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--hair-2);
    /* 44px 圆号是凸起点（--surface-1 凹 / --surface-2 卡 / --surface-3 凸） */
    background: var(--surface-3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--mono);
    font-size: 14px;
    /* 序号是字符，强调档走非正文强调 --accent-400（4.63 压 --surface-3），不是被 §5.3 锁定的 300 */
    color: var(--accent-400);
    margin-bottom: 16px;
  }
  .step h3 {
    font-size: 16px;
    margin-bottom: 8px;
  }
  .step p {
    font-size: 13.5px;
    color: var(--text-2);
  }
  .step.current .snum {
    background: var(--accent-fill);
    /* 填充仍是主按钮那一档（压 band 的 --surface-1 实测 3.40，过非文字 3:1）；
       但这条 1px 描边表达的是「当前步骤」这一状态，按台账通则 3 走 --accent-400，
       不跟着填充写 --accent-fill。 */
    border-color: var(--accent-400);
    color: var(--text-1);
  }
  @media (max-width: 880px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 22px;
    }
    .step:not(:last-child)::after {
      display: none;
    }
  }
</style>
