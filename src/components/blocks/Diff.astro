---
import type { Copy } from '@/lib/copy';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const diff = copy.diff;
const cmp = copy.cmp;
---

<section class="reveal" id="diff">
  <div class="wrap">
    <div class="eyebrow">{diff.eyebrow}</div>
    <h2 class="h-2"><span>{diff.title}</span><br><span class="accent">{diff.title2}</span></h2>
    <p class="qualifier"><b>{diff.qualLead}</b>{diff.qualRest}</p>
    <div class="cmp">
      <div class="cmp-row">
        <div class="k"><span class="mk">✗</span><span>{cmp['1t']}</span></div>
        <div class="v">{cmp['1b']}</div>
      </div>
      <div class="cmp-row">
        <div class="k"><span class="mk">✗</span><span>{cmp['2t']}</span></div>
        <div class="v">{cmp['2b']}</div>
      </div>
      <div class="cmp-row">
        <div class="k"><span class="mk">✗</span><span>{cmp['3t']}</span></div>
        <div class="v">{cmp['3b']}</div>
      </div>
      <div class="cmp-row us">
        <div class="k"><span class="mk">◆</span><span>Wrisp</span></div>
        <div class="v">{cmp['4b']}</div>
      </div>
      <div class="rec-strip" aria-hidden="true">
        <svg viewBox="0 0 460 120" width="100%" role="presentation">
          <rect x="8" y="40" width="120" height="40" rx="10" fill="var(--surface-2)" stroke="var(--hair-2)"/>
          <rect x="22" y="54" width="58" height="6" rx="3" fill="var(--text-3)"/>
          <circle cx="96" cy="57" r="3" fill="var(--accent-400)"/>
          <circle cx="108" cy="57" r="3" fill="var(--accent-400)" opacity=".4"/>
          <path d="M136 60h40" stroke="var(--text-3)"/>
          <path d="M168 54l8 6-8 6" fill="none" stroke="var(--accent-400)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          <rect x="188" y="14" width="80" height="92" rx="10" fill="var(--surface-2)" stroke="var(--hair-2)"/>
          <rect x="198" y="26" width="30" height="12" rx="4" fill="var(--accent-fill)"/>
          <rect x="198" y="48" width="58" height="5" rx="2.5" fill="var(--text-3)"/>
          <rect x="198" y="60" width="50" height="5" rx="2.5" fill="var(--text-3)"/>
          <rect x="198" y="78" width="34" height="5" rx="2.5" fill="var(--text-3)"/>
          <rect x="278" y="14" width="80" height="92" rx="10" fill="var(--surface-2)" stroke="var(--hair-2)"/>
          <circle cx="294" cy="30" r="6" fill="none" stroke="var(--hair-3)"/>
          <rect x="306" y="27" width="42" height="5" rx="2.5" fill="var(--text-3)"/>
          <circle cx="294" cy="52" r="6" fill="var(--accent-fill)" stroke="var(--accent-400)"/>
          <rect x="306" y="49" width="38" height="5" rx="2.5" fill="var(--text-3)"/>
          <circle cx="294" cy="74" r="6" fill="none" stroke="var(--hair-3)"/>
          <rect x="306" y="71" width="40" height="5" rx="2.5" fill="var(--text-3)"/>
          <rect x="368" y="14" width="80" height="92" rx="10" fill="var(--surface-2)" stroke="var(--hair-2)"/>
          <rect x="378" y="26" width="40" height="6" rx="3" fill="var(--text-2)"/>
          <rect x="378" y="44" width="58" height="4" rx="2" fill="var(--text-3)"/>
          <rect x="378" y="54" width="50" height="4" rx="2" fill="var(--text-3)"/>
          <rect x="378" y="72" width="28" height="12" rx="4" fill="var(--accent-fill)"/>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  /* 原型里 h2 的 max-width 是行内样式，端口一律收成 scoped 规则 */
  .h-2 {
    max-width: 880px;
  }
  /*
   * 这个 span 一直带着 class="accent" 却没有对应规则，等于半句钩子写在标记里、
   * 视觉上从没发生过。补上的依据与 01 区 hero 同一条：拆两半的标题，后半句是重音所在，
   * 用强调色；暗色下强调色仍只有品牌蓝一族，不另开深浅。落点 --accent-400 而不是
   * --accent-300——spec §5.3 把 300 锁在「正文内链接、focus ring」，标题的后半句是非正文
   * 强调（与 Hero.astro:156 的 .h-title .accent 同一处装置、同一个值）。
   */
  .h-2 .accent {
    color: var(--accent-400);
  }
  .rec-strip {
    margin-top: 22px;
    max-width: 560px;
    border: 1px solid var(--hair-2);
    border-radius: var(--r-panel);
    background: var(--surface-1);
    padding: 14px 16px;
  }
  .rec-strip svg {
    display: block;
  }
  .cmp {
    margin-top: 38px;
    border: 1px solid var(--hair-1);
    border-radius: var(--r-card);
    overflow: hidden;
    background: var(--surface-2);
  }
  .cmp-row {
    display: grid;
    grid-template-columns: 230px 1fr;
    border-bottom: 1px solid var(--hair-1);
  }
  .cmp-row:last-child {
    border-bottom: 0;
  }
  .cmp-row .k {
    padding: 16px 18px;
    font-weight: 600;
    font-size: 14.5px;
    border-right: 1px solid var(--hair-1);
    display: flex;
    align-items: center;
    gap: 9px;
    /* 左列是卡内的凹面（判面规则：--surface-1 凹 / --surface-2 卡 / --surface-3 凸） */
    background: var(--surface-1);
  }
  .cmp-row .v {
    padding: 16px 18px;
    font-size: 14px;
    color: var(--text-2);
  }
  .cmp-row .mk {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-3);
    flex: none;
  }
  .cmp-row.us {
    background: var(--badge-meet-bg);
  }
  .cmp-row.us .k {
    background: var(--badge-meet-bg);
    color: var(--badge-meet);
    border-right-color: var(--hair-3);
  }
  .cmp-row.us .v {
    color: var(--text-1);
    font-weight: 600;
  }
  .cmp-row.us .mk {
    /* ◆ 承载字符，走强调族；--accent-300 被 spec §5.3 锁定给链接与焦点环，
       此处取 --accent-400（压 --badge-meet-bg 实测 4.76） */
    color: var(--accent-400);
  }
  .qualifier {
    margin-top: 18px;
    font-size: 14.5px;
    color: var(--text-2);
    max-width: 680px;
  }
  .qualifier b {
    color: var(--text-1);
  }
  /*
   * 加粗的引导句和后半句之间必须有间隔：拉丁文没有它就是 decide.It 这种粘连，
   * 而中文句号后面本来不留空。所以这个空格只能挂在语言上——写进模板会把中文一起撑开，
   * 写进文案叶则是看不见、一改就丢的东西。
   */
  :lang(en) .qualifier b::after {
    content: ' ';
  }
  @media (max-width: 760px) {
    .cmp-row {
      grid-template-columns: 1fr;
    }
    .cmp-row .k {
      border-right: 0;
      border-bottom: 1px solid var(--hair-1);
    }
  }
</style>
