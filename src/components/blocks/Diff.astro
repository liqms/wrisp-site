---
import type { Copy } from '@/lib/copy';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const diff = copy.diff;
const cmp = copy.cmp;
---

<section class="reveal" id="diff">
  <div class="wrap">
    <div class="eyebrow">{diff.eyebrow}</div>
    <h2 class="h-2"><span>{diff.title}</span><br><span class="accent">{diff.title2}</span></h2>
    <p class="qualifier"><b>{diff.qualLead}</b>{diff.qualRest}</p>
    <div class="cmp">
      <div class="cmp-row">
        <div class="k"><span class="mk">✗</span><span>{cmp['1t']}</span></div>
        <div class="v">{cmp['1b']}</div>
      </div>
      <div class="cmp-row">
        <div class="k"><span class="mk">✗</span><span>{cmp['2t']}</span></div>
        <div class="v">{cmp['2b']}</div>
      </div>
      <div class="cmp-row">
        <div class="k"><span class="mk">✗</span><span>{cmp['3t']}</span></div>
        <div class="v">{cmp['3b']}</div>
      </div>
      <div class="cmp-row us">
        <div class="k"><span class="mk">◆</span><span>Wrisp</span></div>
        <div class="v">{cmp['4b']}</div>
      </div>
    </div>
  </div>
</section>

<style>
  /* 原型里 h2 的 max-width 是行内样式，端口一律收成 scoped 规则 */
  .h-2 {
    max-width: 880px;
  }
  /*
   * 这个 span 一直带着 class="accent" 却没有对应规则，等于半句钩子写在标记里、
   * 视觉上从没发生过。补上的依据与 01 区 hero 同一条：拆两半的标题，后半句是重音所在，
   * 用强调色；强调色经裁决统一为靛蓝（§4.1）。用 --accent 而非 --accent-ink，
   * 与 01 区同一处装置保持同一个值，不在此处另开一档深浅。
   */
  .h-2 .accent {
    color: var(--accent);
  }
  .cmp {
    margin-top: 38px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: #fff;
  }
  .cmp-row {
    display: grid;
    grid-template-columns: 230px 1fr;
    border-bottom: 1px solid var(--line);
  }
  .cmp-row:last-child {
    border-bottom: 0;
  }
  .cmp-row .k {
    padding: 16px 18px;
    font-weight: 600;
    font-size: 14.5px;
    border-right: 1px solid var(--line);
    display: flex;
    align-items: center;
    gap: 9px;
    background: var(--paper);
  }
  .cmp-row .v {
    padding: 16px 18px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .cmp-row .mk {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
    flex: none;
  }
  .cmp-row.us {
    background: var(--accent-soft);
  }
  .cmp-row.us .k {
    background: var(--accent-soft);
    color: var(--accent-ink);
    border-right-color: #D7DDF6;
  }
  .cmp-row.us .v {
    color: var(--ink);
    font-weight: 600;
  }
  .cmp-row.us .mk {
    color: var(--accent);
  }
  .qualifier {
    margin-top: 18px;
    font-size: 14.5px;
    color: var(--ink-2);
    max-width: 680px;
  }
  .qualifier b {
    color: var(--ink);
  }
  /*
   * 加粗的引导句和后半句之间必须有间隔：拉丁文没有它就是 decide.It 这种粘连，
   * 而中文句号后面本来不留空。所以这个空格只能挂在语言上——写进模板会把中文一起撑开，
   * 写进文案叶则是看不见、一改就丢的东西。
   */
  :lang(en) .qualifier b::after {
    content: ' ';
  }
  @media (max-width: 760px) {
    .cmp-row {
      grid-template-columns: 1fr;
    }
    .cmp-row .k {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
