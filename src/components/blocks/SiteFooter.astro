---
import type { Copy } from '@/lib/copy';
import { leafKey } from '@/lib/copy';
import { localePath } from '@/lib/locales';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const foot = copy.foot;
const here = leafKey(Astro.currentLocale || '');
const releases = 'https://github.com/liqms/wrisp-releases';
---

<footer>
  <div class="foot-inner">
    <span class="foot-brand">◆ Wrisp</span>
    <span>{foot.copy}</span>
    <div class="foot-links">
      <a href={releases} target="_blank" rel="noopener">{foot.releases}</a>
      <a href={`${releases}/issues`} target="_blank" rel="noopener">{foot.feedback}</a>
      <a href={localePath(here, 'privacy/')}>{foot.privacy}</a>
      <a href={localePath(here, 'changelog/')}>{foot.changelog}</a>
      <a href={localePath(here, 'how-it-works/')}>{foot.how}</a>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--hair-1);
    padding: 34px 0 48px;
    color: var(--text-3);
    font-size: 13px;
  }
  /* 刻意不套 .wrap：页脚左右留白恒为 28px，不跟随 .wrap 在 640px 收窄到 20px */
  .foot-inner {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    align-items: center;
    /* 2026-11-06 裁决：页脚去掉语言切换后剩余三件（品牌行 / 版权 / 链接组）作为一组居中，
       不再两端分开；gap 与换行规则不动，窄屏换行后每行同样居中。 */
    justify-content: center;
  }
  .foot-links {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
  }
  .foot-links a:hover {
    color: var(--text-1);
  }
  .foot-brand {
    font-weight: 600;
    color: var(--text-1);
    white-space: nowrap;
  }
</style>
