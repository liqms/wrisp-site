---
import type { Copy } from '@/lib/copy';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const pain = copy.pain;
---

<section class="band reveal" id="pain">
  <div class="wrap">
    <div class="eyebrow">{pain.eyebrow}</div>
    <h2 class="h-2">{pain.title}</h2>
    <p class="lead">{pain.sub}</p>
    <div class="pain-grid">
      <div class="pain-card">
        <div class="pi"><span class="pic" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="8" height="8" rx="2"/><rect x="13" y="13" width="8" height="8" rx="2"/><circle cx="17" cy="7" r="1.7"/><circle cx="7" cy="17" r="1.7"/></svg></span><span>01</span></div>
        <h3>{pain['1t']}</h3>
        <p>{pain['1b']}</p>
      </div>
      <div class="pain-card">
        <div class="pi"><span class="pic" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h12v17l-6-4-6 4z"/><path d="M12 2v6"/><path d="M9 5l3 3 3-3"/></svg></span><span>02</span></div>
        <h3>{pain['2t']}</h3>
        <p>{pain['2b']}</p>
      </div>
      <div class="pain-card punch">
        <div class="pi"><span class="pic" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="10.5" cy="10.5" r="6"/><path d="M15 15l5 5"/><path d="M8 10.5h5"/></svg></span><span>03</span></div>
        <h3>{pain['3t']}</h3>
        <p>{pain['3b']}</p>
        <span class="tag">{pain['3tag']}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .pain-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 40px;
  }
  .pain-card {
    border: 1px solid var(--hair-1);
    border-radius: var(--r-card);
    padding: 24px 22px;
    background: var(--surface-2);
    transition: border-color 0.18s, transform 0.18s;
  }
  .pain-card:hover {
    border-color: var(--hair-2);
    transform: translateY(-2px);
  }
  .pain-card .pi {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-3);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .pain-card .pi .pic {
    display: inline-flex;
    color: var(--text-2);
  }
  .pain-card.punch .pi .pic {
    color: var(--text-1);
  }
  .pain-card h3 {
    font-size: 19px;
    margin: 10px 0 8px;
  }
  .pain-card p {
    font-size: 14px;
    color: var(--text-2);
  }
  /*
   * 第三张是这区的重音：旧版靠「白卡里插一块黑卡」反白来做，暗色家族里没有更深的
   * 卡片档可反，改按判面规则往凸起那一档走（--surface-1 凹 / --surface-2 卡 / --surface-3 凸）。
   * 代价：--text-3 压 --surface-3 只有 4.19（spec §5.2 限 ≥24px），所以这里承载字符的
   * 小字一律从 --on-dark-3 落 --text-2，层级仍由 --text-1 / --text-2 拉开。
   */
  .pain-card.punch {
    background: var(--surface-3);
    border-color: var(--hair-2);
    /* 02 punch 与 06 dropzone 共用面板档圆角，比常规卡收一档，重音读起来更像一块嵌板 */
    border-radius: var(--r-panel);
    color: var(--text-1);
  }
  .pain-card.punch .pi {
    color: var(--text-2);
  }
  .pain-card.punch p {
    color: var(--text-2);
  }
  .pain-card.punch .tag {
    display: inline-block;
    margin-top: 14px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-1);
    border: 1px solid var(--hair-3);
    border-radius: 999px;
    padding: 3px 10px;
  }
  .pain-card.punch:hover {
    border-color: var(--hair-3);
  }
  @media (max-width: 880px) {
    .pain-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
