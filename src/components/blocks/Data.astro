---
import type { Copy } from '@/lib/copy';
import { leafKey } from '@/lib/copy';
import { localePath } from '@/lib/locales';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const data = copy.data;
// 声明从首页区块独立成页，这里的链接因此必须带语言前缀，不能写死 /privacy/
const privacyHref = localePath(leafKey(Astro.currentLocale), 'privacy/');
---

<section class="reveal" id="data">
  <div class="wrap">
    <div class="eyebrow">{data.eyebrow}</div>
    <h2 class="h-2">{data.title}</h2>
    <p class="lead">{data.sub}</p>
    <div class="flow" aria-hidden="true">
      <svg viewBox="0 0 480 132" width="100%" role="presentation">
        <rect x="8" y="30" width="128" height="72" rx="12" fill="var(--surface-2)" stroke="var(--hair-2)"/>
        <rect x="20" y="44" width="56" height="12" rx="4" fill="var(--accent-fill)"/>
        <rect x="20" y="66" width="96" height="5" rx="2.5" fill="var(--text-3)"/>
        <rect x="20" y="78" width="76" height="5" rx="2.5" fill="var(--text-3)"/>
        <circle cx="122" cy="88" r="5" fill="var(--accent-400)"/>
        <path d="M144 66h36" stroke="var(--text-3)"/>
        <path d="M174 60l7 6-7 6" fill="none" stroke="var(--accent-400)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        <rect x="188" y="30" width="128" height="72" rx="12" fill="var(--surface-2)" stroke="var(--ok)" stroke-opacity=".55"/>
        <rect x="200" y="44" width="64" height="12" rx="4" fill="var(--accent-fill)"/>
        <rect x="200" y="66" width="96" height="5" rx="2.5" fill="var(--text-3)"/>
        <rect x="200" y="78" width="62" height="5" rx="2.5" fill="var(--text-3)"/>
        <circle cx="302" cy="88" r="5" fill="var(--ok)"/>
        <path d="M324 66h36" stroke="var(--text-3)" stroke-dasharray="4 4"/>
        <path d="M354 60l7 6-7 6" fill="none" stroke="var(--text-3)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        <rect x="368" y="30" width="104" height="72" rx="12" fill="none" stroke="var(--hair-3)" stroke-dasharray="4 4"/>
        <rect x="380" y="44" width="60" height="12" rx="4" fill="var(--surface-3)"/>
        <rect x="380" y="66" width="76" height="5" rx="2.5" fill="var(--text-3)"/>
        <rect x="380" y="78" width="54" height="5" rx="2.5" fill="var(--text-3)"/>
        <circle cx="458" cy="88" r="5" fill="none" stroke="var(--text-3)"/>
      </svg>
    </div>
    <div class="trust-sheet">
      <div class="trust-row">
        <span class="tick">✓</span>
        <h3>{data['1t']}</h3>
        <p>{data['1b']}</p>
      </div>
      <div class="trust-row">
        <span class="tick">✓</span>
        <h3>{data['2t']}</h3>
        <p>{data['2b']}</p>
      </div>
      <div class="trust-row">
        <span class="tick">✓</span>
        <h3>{data['3t']}</h3>
        <p>{data['3b']}</p>
      </div>
      <div class="trust-row">
        <span class="tick">✓</span>
        <h3>{data['4t']}</h3>
        <p>{data['4b']}</p>
      </div>
      <p class="trust-foot"><span>{data.note}</span> <a href={privacyHref}>{data.link}</a></p>
    </div>
  </div>
</section>

<style>
  /*
   * 这里是「一张声明」，不是一组功能卡：07 区刚用五张盒子铺满产物，08 若继续用同款
   * 2×2 卡阵列，两区连读就只有密度差、没有重量差，读起来发平。改成一整张带发丝线的
   * 凭证面板——四条承诺逐条落在一行里，末尾的核对入口当作落款——区块的边界由一张
   * 面板承担，读者的眼睛从「挑卡片」切回「逐条读」。
   */
  .flow {
    margin-top: 40px;
    max-width: 620px;
    border: 1px solid var(--hair-2);
    border-radius: var(--r-panel);
    background: var(--surface-1);
    padding: 14px 16px;
  }
  .flow svg {
    display: block;
  }
  .trust-sheet {
    margin-top: 22px;
    border: 1px solid var(--hair-2);
    border-radius: var(--r-card);
    background: var(--surface-2);
    overflow: hidden;
  }
  .trust-row {
    display: grid;
    grid-template-columns: 22px minmax(180px, 26%) 1fr;
    grid-template-areas: "mk tk tx";
    align-items: baseline;
    gap: 0 16px;
    padding: 19px 26px;
    border-bottom: 1px solid var(--hair-1);
  }
  .trust-row .tick {
    grid-area: mk;
    color: var(--ok);
    font-family: var(--mono);
    font-size: 13px;
  }
  .trust-row h3 {
    grid-area: tk;
    font-size: 16.5px;
  }
  .trust-row p {
    grid-area: tx;
    font-size: 14px;
    color: var(--text-2);
  }
  /* 落款条是面板内的凹面（--surface-1 凹 / --surface-2 卡） */
  .trust-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    padding: 18px 26px;
    background: var(--surface-1);
    font-size: 14px;
    color: var(--text-2);
  }
  .trust-foot a {
    /* 正文内链接是 --accent-300 的本职用途（spec §5.3） */
    color: var(--accent-300);
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }
  /* v0.28 P2：08 区头部做一处节奏差（其余区块仍左对齐）——一句式主张居中更像落款 */
  .eyebrow {
    justify-content: center;
  }
  .eyebrow::after {
    display: none;
  }
  .h-2 {
    text-align: center;
  }
  .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }
  @media (max-width: 760px) {
    .trust-row {
      grid-template-columns: 20px 1fr;
      grid-template-areas:
        "mk tk"
        "mk tx";
      gap: 4px 12px;
      padding: 17px 20px;
    }
    .trust-foot {
      padding: 17px 20px;
    }
  }
</style>
