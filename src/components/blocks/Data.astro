---
import type { Copy } from '@/lib/copy';
import { leafKey } from '@/lib/copy';
import { localePath } from '@/lib/locales';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const data = copy.data;
// 声明从首页区块独立成页，这里的链接因此必须带语言前缀，不能写死 /privacy/
const privacyHref = localePath(leafKey(Astro.currentLocale), 'privacy/');
---

<section class="reveal" id="data">
  <div class="wrap">
    <div class="eyebrow">{data.eyebrow}</div>
    <h2 class="h-2">{data.title}</h2>
    <p class="lead">{data.sub}</p>
    <div class="trust-sheet">
      <div class="trust-row">
        <span class="tick">✓</span>
        <h3>{data['1t']}</h3>
        <p>{data['1b']}</p>
      </div>
      <div class="trust-row">
        <span class="tick">✓</span>
        <h3>{data['2t']}</h3>
        <p>{data['2b']}</p>
      </div>
      <div class="trust-row">
        <span class="tick">✓</span>
        <h3>{data['3t']}</h3>
        <p>{data['3b']}</p>
      </div>
      <div class="trust-row">
        <span class="tick">✓</span>
        <h3>{data['4t']}</h3>
        <p>{data['4b']}</p>
      </div>
      <p class="trust-foot"><span>{data.note}</span> <a href={privacyHref}>{data.link}</a></p>
    </div>
  </div>
</section>

<style>
  /*
   * 这里是「一张声明」，不是一组功能卡：07 区刚用五张盒子铺满产物，08 若继续用同款
   * 2×2 卡阵列，两区连读就只有密度差、没有重量差，读起来发平。改成一整张带发丝线的
   * 凭证面板——四条承诺逐条落在一行里，末尾的核对入口当作落款——区块的边界由一张
   * 面板承担，读者的眼睛从「挑卡片」切回「逐条读」。
   */
  .trust-sheet {
    margin-top: 44px;
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    background: #fff;
    overflow: hidden;
  }
  .trust-row {
    display: grid;
    grid-template-columns: 22px minmax(180px, 26%) 1fr;
    grid-template-areas: "mk tk tx";
    align-items: baseline;
    gap: 0 16px;
    padding: 19px 26px;
    border-bottom: 1px solid var(--line);
  }
  .trust-row .tick {
    grid-area: mk;
    color: var(--ok);
    font-family: var(--mono);
    font-size: 13px;
  }
  .trust-row h3 {
    grid-area: tk;
    font-size: 16.5px;
  }
  .trust-row p {
    grid-area: tx;
    font-size: 14px;
    color: var(--muted);
  }
  .trust-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    padding: 18px 26px;
    background: var(--paper-2);
    font-size: 14px;
    color: var(--ink-2);
  }
  .trust-foot a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }
  @media (max-width: 760px) {
    .trust-row {
      grid-template-columns: 20px 1fr;
      grid-template-areas:
        "mk tk"
        "mk tx";
      gap: 4px 12px;
      padding: 17px 20px;
    }
    .trust-foot {
      padding: 17px 20px;
    }
  }
</style>
