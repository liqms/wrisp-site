---
import Page from '@/layouts/Page.astro';
import SiteNav from '@/components/SiteNav.astro';
import Hero from '@/components/blocks/Hero.astro';
import Pain from '@/components/blocks/Pain.astro';
import Diff from '@/components/blocks/Diff.astro';
import Work from '@/components/blocks/Work.astro';
import Import from '@/components/blocks/Import.astro';
import Proofs from '@/components/blocks/Proofs.astro';
import Data from '@/components/blocks/Data.astro';
import Roadmap from '@/components/blocks/Roadmap.astro';
import Pricing from '@/components/blocks/Pricing.astro';
import Faq from '@/components/blocks/Faq.astro';
import Cta from '@/components/blocks/Cta.astro';
import SiteFooter from '@/components/blocks/SiteFooter.astro';
import { leafKey, loadCopy } from '@/lib/copy';

const key = leafKey(Astro.currentLocale);
const copy = await loadCopy(key);
const meta = copy.meta;
// 产品实体只在首页声明：辅助页描述的是口径，不是一个可下载的东西。
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Wrisp',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'Windows, macOS, Linux',
  url: Astro.url.href,
  description: meta.jsonldDesc,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    description: meta.jsonldOfferDesc,
  },
};
---

<Page title={meta.docTitle} description={meta.docDesc} ogLocale={meta.ogLocale} jsonld={jsonld}>
  <SiteNav copy={copy} />
  <main id="top">
    <Hero copy={copy} />
    <Pain copy={copy} />
    <Diff copy={copy} />
    <Work copy={copy} />
    <Import copy={copy} />
    <Proofs copy={copy} />
    <Data copy={copy} />
    <Roadmap copy={copy} />
    <Pricing copy={copy} />
    <Faq copy={copy} />
    <Cta copy={copy} />
  </main>
  <SiteFooter copy={copy} />
</Page>

<script>
  // 渐显是增强，不是内容：没有 JS 时 .reveal 保持可见（见 global.css 的 .js 前缀）。
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('in');
          io.unobserve(entry.target);
        }
      },
      { threshold: 0.1 },
    );
    for (const el of document.querySelectorAll('.reveal')) io.observe(el);
  }
</script>
