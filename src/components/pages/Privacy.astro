---
import Page from '@/layouts/Page.astro';
import SiteFooter from '@/components/blocks/SiteFooter.astro';
import LangSwitch from '@/components/LangSwitch.astro';
import { leafKey, loadCopy } from '@/lib/copy';
import { localePath } from '@/lib/locales';

const key = leafKey(Astro.currentLocale);
const copy = await loadCopy(key);
const priv = copy.priv;
const home = localePath(key);

/* 表体从原来的行内重复标记改成一份数据：五列三行的重复度不值得手写五遍。 */
const paths = [
  { k: ['Local AI'], b: priv['1b'], s: priv['1s'] },
  { k: ['Model', priv['6k']], b: priv['6b'], s: priv['6s'] },
  { k: ['BYOK', priv['2k']], b: priv['2b'], s: priv['2s'] },
  { k: ['IP', priv['3k']], b: priv['3b'], s: priv['3s'] },
  { k: ['Update'], b: priv['4b'], s: priv['4s'] },
  { k: ['Waitlist'], b: priv['5b'], s: priv['5s'] },
];
---

<Page title={priv.docTitle} description={priv.docDesc} ogLocale={copy.meta.ogLocale}>
  <header class="nav">
    <div class="nav-inner">
      <a class="brand" href={home}><span class="dot">◆</span>Wrisp</a>
      <div class="nav-spacer"></div>
      <LangSwitch seg="privacy/" />
      <a class="btn btn-primary btn-sm nowrap" href={`${home}#waitlist`}>{copy.nav.cta}</a>
    </div>
  </header>

  <main class="doc">
    <div class="wrap">
      <a class="back mono" href={home}>{priv.hBack}</a>
      <div class="eyebrow">{priv.eyebrow}</div>
      <h1 class="h-title">{priv.title}</h1>
      <p class="lead">{priv.sub}</p>

      <div class="pill-table">
        <div class="pt-row head">
          <div class="c">{priv.hPath}</div>
          <div class="c">{priv.hSend}</div>
          <div class="c">{priv.hDefault}</div>
        </div>
        {
          paths.map((row) => (
            <div class="pt-row">
              <div class="c k">
                {row.k[0]}
                {row.k[1] && <span> {row.k[1]}</span>}
              </div>
              <div class="c">{row.b}</div>
              <div class="c st">{row.s}</div>
            </div>
          ))
        }
      </div>
      <ul class="promises">
        <li>{priv.m1}</li>
        <li>{priv.m2}</li>
        <li>{priv.m3}</li>
      </ul>

      <h2 class="h-2">{priv.t2}</h2>
      <ul class="notes">
        <li>{priv.n1}</li>
        <li>{priv.n2}</li>
        <li>{priv.n3}</li>
      </ul>

      <h2 class="h-2">{priv.t3}</h2>
      <p>{priv.d1}</p>
      <p>{priv.d2}</p>

      <h2 class="h-2">{priv.t4}</h2>
      <p>{priv.v1}</p>
      <p>{priv.v2}</p>

      <p class="stamp mono">{priv.stamp}</p>
    </div>
  </main>

  <SiteFooter copy={copy} />
</Page>

<style>
  .doc {
    padding-block: 56px 96px;
  }
  .back {
    display: inline-block;
    font-size: 12.5px;
    color: var(--muted);
    margin-bottom: 34px;
  }
  .back:hover {
    color: var(--accent);
  }
  .doc h1 {
    margin-top: 14px;
    max-width: 900px;
  }
  .doc h2 {
    margin-top: 64px;
    margin-bottom: 14px;
  }
  .doc p {
    font-size: 15.5px;
    color: var(--ink-2);
    max-width: 760px;
    margin-bottom: 10px;
  }
  .pill-table {
    margin-top: 34px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: #fff;
  }
  .pt-row {
    display: grid;
    grid-template-columns: 200px 1fr 190px;
    border-bottom: 1px solid var(--line);
  }
  .pt-row:last-child {
    border-bottom: 0;
  }
  .pt-row.head {
    background: var(--paper);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pt-row .c {
    padding: 14px 18px;
    font-size: 13.5px;
    color: var(--ink-2);
    border-right: 1px solid var(--line);
  }
  .pt-row .c:last-child {
    border-right: 0;
  }
  .pt-row .c.k {
    font-weight: 600;
    color: var(--ink);
  }
  .pt-row .c.st {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--muted);
  }
  .promises {
    margin: 24px 0 0 18px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .promises li {
    margin-bottom: 8px;
  }
  .notes {
    margin: 0 0 0 18px;
    font-size: 15px;
    color: var(--ink-2);
    max-width: 760px;
  }
  .notes li {
    margin-bottom: 10px;
  }
  .stamp {
    margin-top: 56px;
    font-size: 11.5px;
    color: var(--muted);
  }
  @media (max-width: 880px) {
    .pt-row {
      grid-template-columns: 1fr;
    }
    .pt-row .c {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .pt-row.head {
      display: none;
    }
  }
</style>
