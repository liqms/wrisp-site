---
import '../styles/tokens.css';
import '../styles/global.css';
import { leafKey } from '@/lib/copy';
import { localeRoot, localeSegment } from '@/lib/locales';

interface Props {
  title: string;
  description: string;
  ogLocale: string;
  /** 结构化数据由页面自己给：首页是 SoftwareApplication，辅助页没有可声明的产品实体。 */
  jsonld?: Record<string, unknown>;
}

const { title, description, ogLocale, jsonld } = Astro.props;
const key = leafKey(Astro.currentLocale);
// public 目录的资源不会被 Astro 自动加 base，这里显式拼，文件名也保持可读、可核对
const asset = (name: string) => new URL(`${import.meta.env.BASE_URL}assets/${name}`, Astro.url.origin).href;
const ogImage = asset(key === 'zh' ? 'og-zh.png' : 'og-en.png');
const canonical = Astro.url.href;
/*
 * hreflang 只认绝对地址：相对值在分享卡片与爬虫里都无法解析。
 * 每页把自己这一族的两种语言写全（含自己），互指成对才成立；x-default 落在无前缀的英文侧。
 * 段路径从当前地址剥掉语言前缀得到，所以 /privacy/ 与 /zh/privacy/ 自动互认，不必每加一页改一次。
 */
const root = (path: string) => new URL(path, Astro.url.origin).href;
const seg = localeSegment(Astro.url.pathname);
const alternates: { lang: string; href: string }[] = [
  { lang: 'en', href: root(localeRoot.en + seg) },
  { lang: 'zh-CN', href: root(localeRoot.zh + seg) },
  { lang: 'x-default', href: root(localeRoot.en + seg) },
];
---
<html lang={Astro.currentLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FAFAF7" />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Wrisp" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href={asset("logo.svg")} />
    <link rel="icon" type="image/png" sizes="512x512" href={asset("logo.png")} />
    <link rel="apple-touch-icon" href={asset("logo.png")} />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <slot />
  </body>
</html>
