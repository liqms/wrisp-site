---
import '../styles/tokens.css';
import '../styles/global.css';
import { leafKey } from '@/lib/copy';
import { localeRoot, localeSegment } from '@/lib/locales';

interface Props {
  title: string;
  description: string;
  ogLocale: string;
  /** 结构化数据由页面自己给：首页是 SoftwareApplication，辅助页没有可声明的产品实体。 */
  jsonld?: Record<string, unknown>;
}

const { title, description, ogLocale, jsonld } = Astro.props;
const key = leafKey(Astro.currentLocale || '');
// Cloudflare Web Analytics：token 由构建期注入，未配置就不渲染 beacon（本地开发不加载）。
// token 设计上会出现在页面源码中（beacon 公开嵌入），但仍走 env 以便按环境开关。
const analyticsToken = (import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN as string | undefined) ?? '';
// public 目录的资源不会被 Astro 自动加 base，这里显式拼，文件名也保持可读、可核对
const asset = (name: string) => new URL(`${import.meta.env.BASE_URL}assets/${name}`, Astro.url.origin).href;
const ogImage = asset(key === 'zh' ? 'og-zh.png' : 'og-en.png');
/*
 * 图标是同站资源，按根相对发：跟着当前 origin 走，本地验证台不会去拉生产域的图标；
 * 也正因为写成 `/...`，CI 的「站内绝对 href 必须落在 dist 里」那一步能顺带守住它们不变成死链。
 */
const sitePath = (path: string) => new URL(`${import.meta.env.BASE_URL}${path}`, Astro.url.origin).pathname;
const icon = (name: string) => sitePath(`assets/${name}`);
/*
 * /favicon.ico 是浏览器自己的请求，不受 <link rel="icon"> 支配：标签页兜底、书签与部分爬虫
 * 都会直接拿站点根上这个文件，缺一次就每次访问留一条 404。public/favicon.ico 是 16–256 的
 * 多尺寸 ICO（与 logo 同源导出），head 里再声明它一次，浏览器与探测请求都落到同一张图上。
 */
const faviconIco = sitePath('favicon.ico');
/*
 * 标题字体只子集到拉丁：unicode-range 里没有汉字，中文一律不触发下载，
 * 仍然走系统栈（§4.2 的硬约束）。这份文件是本仓自托管的静态资产，不发向任何内容网络，
 * 所以 /privacy 里「不向任何内容网络发请求」照旧成立——但「字体全用系统栈」那句不再成立，已同步改口径。
 * preload 是为了压掉换字闪烁：23.8 KB 且只有 700 一字重，先到先得比 swap 后再换更稳。
 * 地址用根相对而不是绝对：字体是同站资源，跟着当前 origin 走才对——绝对地址在本地验证台上永远加载不到，
 * 换域名时也要重生成；og:image 那类才必须绝对（分享卡片要能被外部抓取）。
 */
const displayFont = sitePath('assets/newsreader-700-latin.woff2');
/*
 * 这段 @font-face 只能在这里发，不能放进 tokens.css：
 * Astro 的 <style is:inline> 原样输出不插值，所以字符串在此处拼好后用 set:html 注进去。
 */
const fontFace = `@font-face{font-family:'Newsreader';font-style:normal;font-weight:700;font-display:swap;src:url('${displayFont}') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`;
const canonical = Astro.url.href;
// Bing 站长验证：meta 验证码属站点公开信息，随页面发布；四页共用此布局即全部覆盖。
const bingVerification = '279497BAB24BC3ED00FEAFFACDF54F4A';
// 百度站长验证：同 Bing，公开验证码，随页面发布。
const baiduVerification = 'codeva-pkFWCLrDI7';
// Google 站长验证：同 Bing，公开验证码，随页面发布。
const googleVerification = 'A7q12b8I9qYF32rRLSVxcoMwzsyeLQ3x4VXawBEfVPc';
/*
 * hreflang 只认绝对地址：相对值在分享卡片与爬虫里都无法解析。
 * 每页把自己这一族的两种语言写全（含自己），互指成对才成立；x-default 落在无前缀的英文侧。
 * 段路径从当前地址剥掉语言前缀得到，所以 /privacy/ 与 /zh/privacy/ 自动互认，不必每加一页改一次。
 */
const root = (path: string) => new URL(path, Astro.url.origin).href;
const seg = localeSegment(Astro.url.pathname);
const alternates: { lang: string; href: string }[] = [
  { lang: 'en', href: root(localeRoot.en + seg) },
  { lang: 'zh-CN', href: root(localeRoot.zh + seg) },
  { lang: 'x-default', href: root(localeRoot.en + seg) },
];
---
<html lang={Astro.currentLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0d12" />
    <meta name="msvalidate.01" content={bingVerification} />
    <meta name="baidu-site-verification" content={baiduVerification} />
    <meta name="google-site-verification" content={googleVerification} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Wrisp" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href={faviconIco} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={icon("logo.svg")} />
    <link rel="icon" type="image/png" sizes="512x512" href={icon("logo.png")} />
    <link rel="apple-touch-icon" href={icon("logo.png")} />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFace}></style>
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    {analyticsToken && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${analyticsToken}"}`}></script>
    )}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <slot />
  </body>
</html>
